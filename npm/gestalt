#!/usr/bin/env node
// npm owns this installation, including when invoked through its global shim.
process.env.GESTALT_MANAGER_DISTRIBUTION = 'npm';
const { main } = await import('../lib/gestalt.mjs');
try { process.exitCode = await main(); }
catch (error) {
  console.error(`gestalt: ${error instanceof Error ? error.message : 'CLI failed'}`);
  process.exitCode = 1;
}
