{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "test": "bash tests/run.sh",
    "test:browser": "playwright test",
    "test:playwright:real": "node --test tests/playwright-real.test.mjs",
    "test:playwright:cli": "node --test tests/playwright-cli-control.test.mjs tests/playwright-cli-native.test.mjs tests/playwright-cli-startup.test.mjs",
    "test:playwright:cli:plan": "GESTALT_PLAYWRIGHT_CLI_INTEGRATION=1 node --test tests/playwright-cli-native.test.mjs",
    "test:playwright:cli:real": "GESTALT_PLAYWRIGHT_CLI_REAL=1 node --test tests/playwright-cli-native.test.mjs"
  },
  "devDependencies": {
    "@openai/codex": "0.160.0",
    "@playwright/test": "^1.62.1",
    "esbuild": "0.27.7",
    "smol-toml": "1.9.0",
    "vitepress": "^2.0.0-alpha.17",
    "vue": "^3.5.32"
  }
}
