#!/usr/bin/env bash
# Manage the isolated Gestalt Codex profile and Gestalt Mobile installation.
set -Eeuo pipefail
IFS=$'\n\t'

readonly GESTALT_CLI_VERSION='0.2.0'
readonly DEFAULT_INSTALL_BASE_URL='https://dyne.github.io/gestalt'
readonly DEFAULT_MARKETPLACE='dyne/gestalt-agents'
readonly DEFAULT_MARKETPLACE_NAME='dyne-gestalt-agents'
readonly SUPERVISION_CAPABILITY_SCHEMA=1
readonly SUPERVISION_CONTRACT_VERSION=1
manager_update_temp_root=''
manager_update_staged_target=''
update_restart_lock=''
skills_transfer_temp_root=''
skills_export_staged_target=''

log() {
  printf 'gestalt: %s\n' "$*" >&2
}

die() {
  log "error: $*"
  exit 1
}

on_error() {
  local -r exit_code=$?
  local -r line_number=${1:-unknown}
  log "command failed near line ${line_number} (exit ${exit_code})"
  exit "$exit_code"
}
trap 'on_error "$LINENO"' ERR

cleanup() {
  if [[ -n $manager_update_temp_root && -d $manager_update_temp_root ]]; then
    rm -rf -- "$manager_update_temp_root"
  fi
  if [[ -n $manager_update_staged_target && -f $manager_update_staged_target ]]; then
    rm -f -- "$manager_update_staged_target"
  fi
  if [[ -n $update_restart_lock && -d $update_restart_lock ]]; then
    rmdir -- "$update_restart_lock" 2>/dev/null || true
  fi
  if [[ -n $skills_transfer_temp_root && -d $skills_transfer_temp_root ]]; then
    rm -rf -- "$skills_transfer_temp_root"
  fi
  if [[ -n $skills_export_staged_target && -f $skills_export_staged_target ]]; then
    rm -f -- "$skills_export_staged_target"
  fi
}
trap cleanup EXIT

usage() {
  cat <<'EOF'
Usage: gestalt <command> [options]

Manage Gestalt Agents and Gestalt Mobile in isolated, user-owned directories.

Commands:
  install [--extra-skills]  Install or reconcile Agents and Mobile.
  update [--extra-skills]   Upgrade the manager, Agents, and Mobile.
  update-restart [--extra-skills]
                            Update from a live Mobile session, then restart Mobile.
  cli [--] [args...]        Start Codex with ~/.codex-gestalt as CODEX_HOME.
  mobile [--] [args...]     Start the managed Gestalt Mobile executable.
  skills-export [ARCHIVE]   Export installed skills and skill profiles.
  skills-import ARCHIVE     Import a skills archive into this installation.
  doctor                    Check prerequisites and installation state.
  version                   Print this manager's version.
  help                      Show this help.

Environment:
  CODEX_HOME                 Isolated Codex home (default: ~/.codex-gestalt).
  GESTALT_HOME               Runtime and Mobile root (default: ~/.gestalt).
  GESTALT_INSTALL_BASE_URL   Manager update source (default: https://dyne.github.io/gestalt).
  GESTALT_MARKETPLACE        Marketplace source (default: dyne/gestalt-agents).
  GESTALT_MARKETPLACE_NAME   Codex checkout name (default: dyne-gestalt-agents).
  GESTALT_MOBILE_VERSION     npm version or tag (default: latest).
EOF
}

require_command() {
  local -r command_name=$1
  command -v "$command_name" >/dev/null 2>&1 ||
    die "$command_name is required and was not found on PATH"
}

validate_managed_path() {
  local -r label=$1
  local -r candidate=$2
  local home_path

  [[ $candidate == /* ]] || die "$label must be an absolute path: $candidate"
  [[ $candidate != / ]] || die "refusing unsafe $label: /"
  home_path=$(CDPATH='' cd -- "${HOME:?HOME is required}" && pwd -P)
  [[ $candidate != "$home_path" ]] || die "refusing to use HOME itself as $label"
}

load_paths() {
  : "${HOME:?HOME is required}"
  codex_home=${CODEX_HOME:-$HOME/.codex-gestalt}
  gestalt_home=${GESTALT_HOME:-$HOME/.gestalt}
  install_base_url=${GESTALT_INSTALL_BASE_URL:-$DEFAULT_INSTALL_BASE_URL}
  marketplace=${GESTALT_MARKETPLACE:-$DEFAULT_MARKETPLACE}
  marketplace_name=${GESTALT_MARKETPLACE_NAME:-$DEFAULT_MARKETPLACE_NAME}
  mobile_version=${GESTALT_MOBILE_VERSION:-latest}
  mobile_root=$gestalt_home/mobile
  mobile_bin=$mobile_root/node_modules/.bin/gestalt-mobile
  user_skills_root=$HOME/.agents/skills
  managed_skills_root=$gestalt_home/.agents/skills
  codex_skills_root=$codex_home/skills
  skill_profiles_root=$gestalt_home/skill-profiles
  marketplace_setup=$codex_home/.tmp/marketplaces/$marketplace_name/gestalt-setup.sh
  agents_capability_manifest=$codex_home/.tmp/marketplaces/$marketplace_name/plugins/gestalt/gestalt-supervision-capabilities.json
  mobile_capability_manifest=$mobile_root/node_modules/gestalt-mobile/gestalt-supervision-capabilities.json

  validate_managed_path CODEX_HOME "$codex_home"
  validate_managed_path GESTALT_HOME "$gestalt_home"
  validate_managed_path 'user skills root' "$user_skills_root"
  validate_managed_path 'managed skills root' "$managed_skills_root"
  validate_managed_path 'Codex skills root' "$codex_skills_root"
  validate_managed_path 'skill profiles root' "$skill_profiles_root"
}

validate_transfer_source_tree() {
  local -r source=$1
  local entry invalid=''

  while IFS= read -r -d '' entry; do
    [[ $entry != *$'\n'* && $entry != *$'\r'* ]] ||
      die "skill archive paths cannot contain newlines: $entry"
  done < <(find "$source" -print0)

  invalid=$(find "$source" ! -type d ! -type f -print -quit)
  [[ -z $invalid ]] || die "skill contains an unsupported link or special file: $invalid"
}

path_is_within() {
  local -r candidate=$1
  local -r parent=$2
  [[ $candidate == "$parent" || $candidate == "$parent"/* ]]
}

copy_export_skill_root() {
  local -r source=$1
  local -r destination=$2
  local entry name resolved
  local restore_dotglob=false restore_nullglob=false
  local -a entries=()

  mkdir -p -- "$destination"
  [[ -d $source ]] || return 0
  [[ ! -L $source ]] || die "skill root cannot be a symbolic link: $source"

  if ! shopt -q dotglob; then shopt -s dotglob; restore_dotglob=true; fi
  if ! shopt -q nullglob; then shopt -s nullglob; restore_nullglob=true; fi
  entries=("$source"/*)
  "$restore_dotglob" && shopt -u dotglob
  "$restore_nullglob" && shopt -u nullglob

  for entry in "${entries[@]}"; do
    name=${entry##*/}
    [[ $name != '.system' ]] || continue
    if [[ -L $entry ]]; then
      resolved=$(CDPATH='' cd -- "$entry" 2>/dev/null && pwd -P) ||
        die "skill link is broken or does not target a directory: $entry"
      if path_is_within "$resolved" "$user_skills_root" ||
        path_is_within "$resolved" "$managed_skills_root" ||
        path_is_within "$resolved" "$codex_skills_root"; then
        continue
      fi
      die "skill link points outside exported roots: $entry -> $resolved"
    fi
    [[ -d $entry && -f $entry/SKILL.md ]] || continue
    [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
      die "skill directory has an unsupported name: $name"
    validate_transfer_source_tree "$entry"
    cp -a -- "$entry" "$destination/$name"
    ((skills_export_count += 1))
  done
}

copy_export_profiles() {
  local -r destination=$1
  local profile name
  local restore_nullglob=false
  local -a profiles=()

  mkdir -p -- "$destination"
  [[ -d $skill_profiles_root ]] || return 0
  [[ ! -L $skill_profiles_root ]] ||
    die "skill profiles root cannot be a symbolic link: $skill_profiles_root"
  if ! shopt -q nullglob; then shopt -s nullglob; restore_nullglob=true; fi
  profiles=("$skill_profiles_root"/*.yml "$skill_profiles_root"/*.yaml)
  "$restore_nullglob" && shopt -u nullglob
  for profile in "${profiles[@]}"; do
    [[ -f $profile && ! -L $profile ]] ||
      die "skill profile must be a regular file: $profile"
    name=${profile##*/}
    [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.ya?ml$ ]] ||
      die "skill profile has an unsupported name: $name"
    cp -a -- "$profile" "$destination/$name"
    ((skills_export_profile_count += 1))
  done
}

command_skills_export() {
  local output output_dir output_name archive_root
  skills_export_count=0
  skills_export_profile_count=0

  (($# <= 1)) || die 'usage: gestalt skills-export [ARCHIVE]'
  require_command tar
  require_command mktemp
  require_command node

  output=${1:-$PWD/gestalt-skills.tar.gz}
  [[ $output == /* ]] || output=$PWD/$output
  output_dir=${output%/*}
  output_name=${output##*/}
  [[ -n $output_name && $output_name != '.' && $output_name != '..' ]] ||
    die "invalid skills archive path: $output"
  [[ -d $output_dir ]] || die "skills archive directory does not exist: $output_dir"
  output_dir=$(CDPATH='' cd -- "$output_dir" && pwd -P) ||
    die "could not resolve skills archive directory: $output_dir"
  output=$output_dir/$output_name
  [[ ! -e $output && ! -L $output ]] || die "refusing to overwrite skills archive: $output"

  skills_transfer_temp_root=$(mktemp -d "${TMPDIR:-/tmp}/gestalt-skills-export.XXXXXXXX") ||
    die 'could not create a temporary directory for skills export'
  archive_root=$skills_transfer_temp_root/gestalt-skills
  mkdir -p -- "$archive_root"

  copy_export_skill_root "$user_skills_root" "$archive_root/user-agents-skills"
  copy_export_skill_root "$managed_skills_root" "$archive_root/managed-skills"
  copy_export_skill_root "$codex_skills_root" "$archive_root/codex-skills"
  copy_export_profiles "$archive_root/skill-profiles"

  node --input-type=module - \
    "$archive_root/manifest.json" "$GESTALT_CLI_VERSION" \
    "$user_skills_root" "$managed_skills_root" "$codex_skills_root" \
    "$skills_export_count" "$skills_export_profile_count" <<'NODE'
import { writeFileSync } from 'node:fs';

const [manifestPath, managerVersion, userSkillsRoot, managedSkillsRoot, codexSkillsRoot,
  skillCount, profileCount] = process.argv.slice(2);
const manifest = {
  format: 'gestalt-skills',
  version: 1,
  managerVersion,
  sourceRoots: { userSkillsRoot, managedSkillsRoot, codexSkillsRoot },
  counts: { skills: Number(skillCount), profiles: Number(profileCount) },
};
writeFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`, { mode: 0o600 });
NODE

  skills_export_staged_target=$(mktemp "$output_dir/.gestalt-skills.XXXXXXXX") ||
    die 'could not stage the skills archive'
  tar -czf "$skills_export_staged_target" -C "$skills_transfer_temp_root" gestalt-skills
  mv -- "$skills_export_staged_target" "$output"
  skills_export_staged_target=''
  rm -rf -- "$skills_transfer_temp_root"
  skills_transfer_temp_root=''
  log "exported $skills_export_count skills and $skills_export_profile_count profiles to $output"
}

validate_skills_archive() {
  local -r archive=$1
  local -r members=$skills_transfer_temp_root/members.txt
  local -r verbose=$skills_transfer_temp_root/verbose.txt
  local member normalized type duplicates=''

  tar -tzf "$archive" > "$members" || die 'could not list skills archive'
  [[ -s $members ]] || die 'skills archive is empty'
  while IFS= read -r member; do
    [[ -n $member && $member != /* ]] ||
      die "unsafe skills archive member: $member"
    case $member in *\\*) die "unsafe skills archive member: $member" ;; esac
    normalized=${member%/}
    [[ /$normalized/ != *'/../'* && /$normalized/ != *'/./'* ]] ||
      die "unsafe skills archive member: $member"
    case $normalized in
      gestalt-skills | gestalt-skills/manifest.json | \
        gestalt-skills/user-agents-skills | gestalt-skills/user-agents-skills/* | \
        gestalt-skills/managed-skills | gestalt-skills/managed-skills/* | \
        gestalt-skills/codex-skills | gestalt-skills/codex-skills/* | \
        gestalt-skills/skill-profiles | gestalt-skills/skill-profiles/*) ;;
      *) die "unexpected skills archive member: $member" ;;
    esac
  done < "$members"
  duplicates=$(sort "$members" | uniq -d | head -n 1)
  [[ -z $duplicates ]] || die "duplicate skills archive member: $duplicates"

  tar -tvzf "$archive" > "$verbose" || die 'could not inspect skills archive'
  while IFS= read -r member; do
    type=${member:0:1}
    [[ $type == '-' || $type == 'd' ]] ||
      die 'skills archive contains a link or special file'
  done < "$verbose"
}

validate_import_skill_root() {
  local -r root=$1
  local entry name
  local restore_dotglob=false restore_nullglob=false
  local -a entries=()

  [[ -d $root && ! -L $root ]] || die "skills archive directory is missing: $root"
  if ! shopt -q dotglob; then shopt -s dotglob; restore_dotglob=true; fi
  if ! shopt -q nullglob; then shopt -s nullglob; restore_nullglob=true; fi
  entries=("$root"/*)
  "$restore_dotglob" && shopt -u dotglob
  "$restore_nullglob" && shopt -u nullglob
  for entry in "${entries[@]}"; do
    name=${entry##*/}
    [[ -d $entry && ! -L $entry && -f $entry/SKILL.md && ! -L $entry/SKILL.md ]] ||
      die "invalid skill in archive: $entry"
    [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
      die "skill archive contains an unsupported name: $name"
  done
}

import_skill_root() {
  local -r source=$1
  local -r destination=$2
  local entry name target
  local restore_dotglob=false restore_nullglob=false
  local -a entries=()

  [[ ! -L $destination ]] || die "destination skill root is a symbolic link: $destination"
  mkdir -p -- "$destination"
  chmod 0700 "$destination"
  if ! shopt -q dotglob; then shopt -s dotglob; restore_dotglob=true; fi
  if ! shopt -q nullglob; then shopt -s nullglob; restore_nullglob=true; fi
  entries=("$source"/*)
  "$restore_dotglob" && shopt -u dotglob
  "$restore_nullglob" && shopt -u nullglob
  for entry in "${entries[@]}"; do
    name=${entry##*/}
    target=$destination/$name
    [[ ! -L $target && ( ! -e $target || -d $target ) ]] ||
      die "refusing unsafe skill destination: $target"
    if [[ -d $target ]]; then validate_transfer_source_tree "$target"; fi
    mkdir -p -- "$target"
    cp -a -- "$entry/." "$target/"
    ((skills_import_count += 1))
  done
}

import_skill_profiles() {
  local -r source=$1
  local profile name target temporary
  local restore_nullglob=false
  local -a profiles=()

  [[ -d $source && ! -L $source ]] || die 'skill profiles directory is missing from archive'
  [[ ! -L $skill_profiles_root ]] ||
    die "destination skill profiles root is a symbolic link: $skill_profiles_root"
  mkdir -p -- "$skill_profiles_root"
  chmod 0700 "$skill_profiles_root"
  if ! shopt -q nullglob; then shopt -s nullglob; restore_nullglob=true; fi
  profiles=("$source"/*.yml "$source"/*.yaml)
  "$restore_nullglob" && shopt -u nullglob
  for profile in "${profiles[@]}"; do
    [[ -f $profile && ! -L $profile ]] || die "invalid skill profile in archive: $profile"
    name=${profile##*/}
    target=$skill_profiles_root/$name
    [[ ! -L $target && ( ! -e $target || -f $target ) ]] ||
      die "refusing unsafe skill profile destination: $target"
    temporary=$(mktemp "$skill_profiles_root/.gestalt-profile.XXXXXXXX") ||
      die "could not stage imported skill profile: $name"
    install -m 0600 "$profile" "$temporary"
    mv -f -- "$temporary" "$target"
    ((skills_import_profile_count += 1))
  done
}

link_imported_managed_skills() {
  local -r source=$1
  local entry name link
  local restore_nullglob=false
  local -a entries=()

  mkdir -p -- "$codex_skills_root"
  if ! shopt -q nullglob; then shopt -s nullglob; restore_nullglob=true; fi
  entries=("$source"/*)
  "$restore_nullglob" && shopt -u nullglob
  for entry in "${entries[@]}"; do
    name=${entry##*/}
    link=$codex_skills_root/$name
    if [[ ! -e $link && ! -L $link ]]; then
      ln -s -- "$managed_skills_root/$name" "$link"
    fi
  done
}

command_skills_import() {
  local -r archive_arg=${1:-}
  local archive_copy archive_root
  skills_import_count=0
  skills_import_profile_count=0

  (($# == 1)) || die 'usage: gestalt skills-import ARCHIVE'
  [[ -n $archive_arg ]] || die 'usage: gestalt skills-import ARCHIVE'
  require_command tar
  require_command mktemp
  require_command node
  require_command install
  [[ -f $archive_arg && ! -L $archive_arg ]] ||
    die "skills archive must be a regular file: $archive_arg"

  skills_transfer_temp_root=$(mktemp -d "${TMPDIR:-/tmp}/gestalt-skills-import.XXXXXXXX") ||
    die 'could not create a temporary directory for skills import'
  archive_copy=$skills_transfer_temp_root/archive.tar.gz
  install -m 0600 "$archive_arg" "$archive_copy"
  validate_skills_archive "$archive_copy"
  tar -xzf "$archive_copy" -C "$skills_transfer_temp_root"
  archive_root=$skills_transfer_temp_root/gestalt-skills

  validate_import_skill_root "$archive_root/user-agents-skills"
  validate_import_skill_root "$archive_root/managed-skills"
  validate_import_skill_root "$archive_root/codex-skills"
  [[ -f $archive_root/manifest.json && ! -L $archive_root/manifest.json ]] ||
    die 'skills archive manifest is missing'

  node --input-type=module - \
    "$archive_root/manifest.json" "$archive_root/skill-profiles" \
    "$user_skills_root" "$managed_skills_root" "$codex_skills_root" <<'NODE'
import { readdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const [manifestPath, profilesRoot, targetUserRoot, targetManagedRoot, targetCodexRoot] =
  process.argv.slice(2);
let manifest;
try {
  manifest = JSON.parse(readFileSync(manifestPath, 'utf8'));
} catch (error) {
  throw new Error(`invalid skills archive manifest: ${error.message}`);
}
if (manifest.format !== 'gestalt-skills' || manifest.version !== 1)
  throw new Error('unsupported skills archive format or version');
const source = manifest.sourceRoots;
if (!source || typeof source !== 'object') throw new Error('skills archive source roots are missing');
const replacements = [
  [source.userSkillsRoot, targetUserRoot],
  [source.managedSkillsRoot, targetManagedRoot],
  [source.codexSkillsRoot, targetCodexRoot],
];
for (const [from, to] of replacements) {
  if (typeof from !== 'string' || !from.startsWith('/') || from === '/')
    throw new Error('skills archive contains an invalid source root');
  if (typeof to !== 'string' || !to.startsWith('/') || to === '/')
    throw new Error('skills import contains an invalid destination root');
}
replacements.sort((left, right) => right[0].length - left[0].length);
for (const entry of readdirSync(profilesRoot, { withFileTypes: true })) {
  if (!entry.isFile() || !/^[A-Za-z0-9][A-Za-z0-9._-]*\.ya?ml$/.test(entry.name))
    throw new Error(`invalid skill profile archive entry: ${entry.name}`);
  const path = join(profilesRoot, entry.name);
  let profile = readFileSync(path, 'utf8');
  for (const [from, to] of replacements) profile = profile.replaceAll(from, to);
  const temporary = `${path}.tmp-${process.pid}`;
  writeFileSync(temporary, profile, { mode: 0o600 });
  renameSync(temporary, path);
}
NODE

  chmod -R u+rwX,go-rwx "$archive_root"
  import_skill_root "$archive_root/user-agents-skills" "$user_skills_root"
  import_skill_root "$archive_root/managed-skills" "$managed_skills_root"
  import_skill_root "$archive_root/codex-skills" "$codex_skills_root"
  import_skill_profiles "$archive_root/skill-profiles"
  link_imported_managed_skills "$archive_root/managed-skills"

  rm -rf -- "$skills_transfer_temp_root"
  skills_transfer_temp_root=''
  log "imported $skills_import_count skills and $skills_import_profile_count profiles from $archive_arg"
}

calculate_sha256() {
  local -r file=$1

  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file"
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file"
  else
    die 'sha256sum or shasum is required to verify the manager'
  fi
}

update_manager() {
  local manager_source manager_dir manager_name manager_target
  local manager_download checksum_download expected_checksum actual_checksum current_checksum

  require_command curl
  require_command install
  require_command mktemp

  manager_source=${BASH_SOURCE[0]}
  manager_dir=$(CDPATH='' cd -- "$(dirname -- "$manager_source")" && pwd -P) ||
    die "could not resolve manager directory: $manager_source"
  manager_name=$(basename -- "$manager_source")
  manager_target=$manager_dir/$manager_name
  [[ -f $manager_target ]] || die "could not resolve manager executable: $manager_target"

  manager_update_temp_root=$(mktemp -d "${TMPDIR:-/tmp}/gestalt-update.XXXXXXXX") ||
    die 'could not create a temporary directory for the manager update'
  manager_download=$manager_update_temp_root/gestalt
  checksum_download=$manager_update_temp_root/gestalt.sha256

  log "checking for a manager update at ${install_base_url%/}/gestalt"
  curl --fail --silent --show-error --location \
    "${install_base_url%/}/gestalt" --output "$manager_download"
  curl --fail --silent --show-error --location \
    "${install_base_url%/}/gestalt.sha256" --output "$checksum_download"

  IFS=' ' read -r expected_checksum _ < "$checksum_download" ||
    die 'could not read the published manager checksum'
  [[ $expected_checksum =~ ^[[:xdigit:]]{64}$ ]] ||
    die 'published manager checksum has an invalid format'

  actual_checksum=$(calculate_sha256 "$manager_download")
  actual_checksum=${actual_checksum%% *}
  [[ $actual_checksum == "$expected_checksum" ]] ||
    die 'manager update checksum verification failed'

  current_checksum=$(calculate_sha256 "$manager_target")
  current_checksum=${current_checksum%% *}
  if [[ $current_checksum == "$actual_checksum" ]]; then
    log "manager is already current at $manager_target"
  else
    manager_update_staged_target=$(mktemp "$manager_dir/.gestalt.XXXXXXXX") ||
      die 'could not stage the manager update'
    install -m 0755 "$manager_download" "$manager_update_staged_target"
    mv -f -- "$manager_update_staged_target" "$manager_target"
    manager_update_staged_target=''
    log "updated manager at $manager_target"
  fi

  rm -rf -- "$manager_update_temp_root"
  manager_update_temp_root=''
}

check_node_version() {
  local version major
  require_command node
  version=$(node -p 'process.versions.node') || die 'could not determine Node.js version'
  major=${version%%.*}
  [[ $major =~ ^[0-9]+$ ]] || die "unexpected Node.js version: $version"
  ((major >= 24)) || die "Node.js 24 or newer is required; found $version"
}

configure_codex_permissions() {
  local -r config_path=$codex_home/config.toml

  node --input-type=module - "$config_path" <<'NODE'
import { chmodSync, existsSync, mkdirSync, readFileSync, renameSync, statSync, writeFileSync } from 'node:fs';
import { dirname } from 'node:path';

const configPath = process.argv[2];
const source = existsSync(configPath) ? readFileSync(configPath, 'utf8') : '';
const lines = source.split(/\r?\n/);
const retained = [];
let section = '';
let removingSection = false;

for (const line of lines) {
  const table = line.match(/^\s*\[([^\]]+)]\s*(?:#.*)?$/);
  if (table) {
    section = table[1].trim();
    removingSection =
      section === 'sandbox_workspace_write' ||
      section === 'permissions.workspace-git' ||
      section.startsWith('permissions.workspace-git.');
    if (removingSection) continue;
  }
  if (removingSection) continue;
  if (
    section === '' &&
    /^\s*(?:approval_policy|default_permissions|sandbox_mode)\s*=/.test(line)
  )
    continue;
  retained.push(line);
}

while (retained.length > 0 && retained[0].trim() === '') retained.shift();
while (retained.length > 0 && retained.at(-1).trim() === '') retained.pop();

const root = [
  'approval_policy = "never"',
  'default_permissions = "workspace-git"',
];
const profile = [
  '[permissions.workspace-git]',
  'description = "Workspace writable including Git metadata"',
  'extends = ":workspace"',
  '',
  '[permissions.workspace-git.filesystem.":workspace_roots"]',
  '"." = "write"',
  '".git" = "write"',
  '".agents" = "read"',
  '".codex" = "read"',
];
const output = [...root, ...(retained.length > 0 ? ['', ...retained] : []), '', ...profile, ''].join('\n');
if (output === source) process.exit(0);

mkdirSync(dirname(configPath), { recursive: true });
const temporary = `${configPath}.tmp-${process.pid}`;
writeFileSync(temporary, output, { encoding: 'utf8', mode: 0o600 });
if (existsSync(configPath)) chmodSync(temporary, statSync(configPath).mode & 0o777);
renameSync(temporary, configPath);
NODE
  log "configured workspace-git permissions in $config_path"
}

install_mobile() {
  check_node_version
  require_command npm
  mkdir -p -- "$mobile_root"
  log "installing gestalt-mobile@${mobile_version} under $mobile_root"
  npm install \
    --prefix "$mobile_root" \
    --no-audit \
    --no-fund \
    --save-exact \
    "gestalt-mobile@${mobile_version}"
  [[ -x $mobile_bin ]] || die "npm completed but the Mobile executable is missing: $mobile_bin"
}

run_marketplace_setup() {
  local -r mode=$1
  local -r include_extra_skills=$2
  local marketplace_action
  local -a setup_args=()

  check_node_version
  require_command npm
  require_command codex
  mkdir -p -- "$codex_home" "$gestalt_home"
  configure_codex_permissions

  marketplace_action=upgrade
  if [[ $mode == install && ! -f $marketplace_setup ]]; then
    marketplace_action=add
  fi

  log "${marketplace_action} marketplace $marketplace in $codex_home"
  if [[ $marketplace_action == add ]]; then
    if ! CODEX_HOME=$codex_home codex plugin marketplace add "$marketplace"; then
      log 'marketplace is already registered; attempting an upgrade'
      CODEX_HOME=$codex_home codex plugin marketplace upgrade "$marketplace_name"
    fi
  else
    if ! CODEX_HOME=$codex_home codex plugin marketplace upgrade "$marketplace_name"; then
      log 'marketplace upgrade was unavailable; attempting a fresh registration'
      CODEX_HOME=$codex_home codex plugin marketplace add "$marketplace"
    fi
  fi

  [[ -f $marketplace_setup ]] ||
    die "marketplace setup script is missing after ${marketplace_action}: $marketplace_setup"

  if [[ $include_extra_skills == true ]]; then
    setup_args+=(--extra-skills)
  fi

  log 'preparing context mode, plugins, and agent profiles'
  CODEX_HOME=$codex_home GESTALT_HOME=$gestalt_home \
    bash "$marketplace_setup" "${setup_args[@]}"
  verify_context_mode_installation
}

parse_setup_options() {
  include_extra_skills=false
  while (($# > 0)); do
    case $1 in
      --extra-skills)
        include_extra_skills=true
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        die "unknown setup option: $1"
        ;;
    esac
    shift
  done
}

command_install() {
  parse_setup_options "$@"
  run_marketplace_setup install "$include_extra_skills"
  install_mobile
  log "installation complete; run 'gestalt doctor', then 'gestalt cli' or 'gestalt mobile'"
}

command_update() {
  parse_setup_options "$@"
  update_manager
  run_marketplace_setup upgrade "$include_extra_skills"
  install_mobile
  log 'manager, Agents, and Mobile are up to date'
}

resolve_manager_target() {
  local manager_source manager_dir manager_name

  manager_source=${BASH_SOURCE[0]}
  manager_dir=$(CDPATH='' cd -- "$(dirname -- "$manager_source")" && pwd -P) ||
    die "could not resolve manager directory: $manager_source"
  manager_name=$(basename -- "$manager_source")
  manager_target=$manager_dir/$manager_name
  [[ -x $manager_target ]] || die "manager executable is unavailable: $manager_target"
}

validate_mobile_restart_context() {
  local -r relay_pid=$1
  local -r restart_state=$2
  local -r expected_state=$gestalt_home/run/mobile-$relay_pid.restart

  [[ $relay_pid =~ ^[1-9][0-9]*$ ]] ||
    die 'update-restart must be run from a session managed by Gestalt Mobile'
  [[ $restart_state == "$expected_state" && -r $restart_state ]] ||
    die 'the Gestalt Mobile restart descriptor is unavailable or invalid'
  process_is_live "$relay_pid" || die 'the managing Gestalt Mobile process is not running'
}

process_is_live() {
  local -r process_pid=$1
  local process_state

  kill -0 "$process_pid" 2>/dev/null || return 1
  process_state=$(ps -o stat= -p "$process_pid" 2>/dev/null) || return 1
  process_state=${process_state//[[:space:]]/}
  [[ $process_state != Z* ]]
}

command_update_restart() {
  local relay_pid restart_state restart_log restart_lock worker_pid manager_target

  parse_setup_options "$@"
  relay_pid=${GESTALT_MOBILE_PID:-}
  restart_state=${GESTALT_MOBILE_RESTART_STATE:-}
  validate_mobile_restart_context "$relay_pid" "$restart_state"
  check_node_version
  resolve_manager_target
  restart_log=$gestalt_home/update-restart.log
  restart_lock=$gestalt_home/run/update-restart.lock
  mkdir -- "$restart_lock" 2>/dev/null ||
    die "another update-restart is already running ($restart_lock)"

  if ! worker_pid=$(node -e '
    const { spawn } = require("node:child_process");
    const [command, ...args] = process.argv.slice(1);
    const child = spawn(command, args, {
      detached: true,
      env: process.env,
      stdio: "ignore",
    });
    child.unref();
    process.stdout.write(String(child.pid));
  ' "$manager_target" __update-restart-worker \
    "$relay_pid" "$restart_state" "$include_extra_skills" "$restart_log" "$restart_lock"); then
    rmdir -- "$restart_lock" 2>/dev/null || true
    die 'could not schedule the detached update and restart worker'
  fi
  if [[ ! $worker_pid =~ ^[1-9][0-9]*$ ]]; then
    rmdir -- "$restart_lock" 2>/dev/null || true
    die 'the detached update worker did not start'
  fi

  log "scheduled update and Mobile restart (worker $worker_pid)"
  log "progress will be written to $restart_log; this session will reconnect after restart"
}

command_update_restart_worker() {
  local -r relay_pid=${1:-}
  local -r restart_state=${2:-}
  local -r worker_extra_skills=${3:-false}
  local -r restart_log=${4:-}
  local -r restart_lock=${5:-}
  local restart_cwd restart_field manager_target
  local -a restart_record restart_args update_args=()

  [[ -n $restart_log ]] || die 'the update-restart worker log path is missing'
  validate_managed_path 'update-restart log' "$restart_log"
  [[ $restart_lock == "$gestalt_home/run/update-restart.lock" && -d $restart_lock ]] ||
    die 'the update-restart worker lock is unavailable or invalid'
  update_restart_lock=$restart_lock
  mkdir -p -- "$(dirname -- "$restart_log")"
  exec >> "$restart_log" 2>&1

  log "starting live update at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  # Let a calling Mobile endpoint flush its accepted response before any fast,
  # already-current update reaches the relay shutdown step.
  sleep 1
  validate_mobile_restart_context "$relay_pid" "$restart_state"
  while IFS= read -r -d '' restart_field; do
    restart_record+=("$restart_field")
  done < "$restart_state"
  ((${#restart_record[@]} >= 1)) || die 'the Gestalt Mobile restart descriptor is empty'
  restart_cwd=${restart_record[0]}
  restart_args=("${restart_record[@]:1}")
  [[ $restart_cwd == /* && -d $restart_cwd ]] ||
    die "the Gestalt Mobile restart directory is invalid: $restart_cwd"
  [[ $worker_extra_skills == false || $worker_extra_skills == true ]] ||
    die 'the update-restart worker received an invalid setup mode'
  if [[ $worker_extra_skills == true ]]; then
    update_args+=(--extra-skills)
  fi

  command_update "${update_args[@]}"
  validate_mobile_restart_context "$relay_pid" "$restart_state"
  log "update succeeded; gracefully stopping Gestalt Mobile process $relay_pid"
  kill -TERM "$relay_pid"
  for ((attempt = 0; attempt < 300; attempt += 1)); do
    if ! process_is_live "$relay_pid"; then
      break
    fi
    sleep 0.1
  done
  process_is_live "$relay_pid" &&
    die 'Gestalt Mobile did not stop within 30 seconds; it was not force-killed'

  rm -f -- "$restart_state"
  rmdir -- "$update_restart_lock"
  update_restart_lock=''
  resolve_manager_target
  cd -- "$restart_cwd"
  log 'restarting Gestalt Mobile with its previous options'
  exec "$manager_target" mobile -- "${restart_args[@]}"
}

strip_separator() {
  if (($# > 0)) && [[ $1 == -- ]]; then
    shift
  fi
  forwarded_args=("$@")
}

command_cli() {
  check_node_version
  require_command codex
  run_startup_diagnostics
  verify_context_mode_installation
  strip_separator "$@"
  log "starting Codex with CODEX_HOME=$codex_home"
  exec env CODEX_HOME="$codex_home" GESTALT_HOME="$gestalt_home" \
    GESTALT_STARTUP_DIAGNOSTICS_DONE=1 \
    PATH="$codex_home/bin:$PATH" \
    codex "${forwarded_args[@]}"
}

command_mobile() {
  local mobile_restart_dir mobile_restart_state mobile_restart_staged restart_cwd
  local plugin_inventory='' gestalt_agents_version='' context_mode_version=''

  strip_separator "$@"
  if [[ ! -x $mobile_bin ]]; then
    log 'Gestalt Mobile is not installed; installing it now'
    install_mobile
  fi
  run_startup_diagnostics
  plugin_inventory=$(CODEX_HOME=$codex_home codex plugin list \
    --marketplace "$marketplace_name" --json 2>/dev/null) || plugin_inventory=''
  if [[ -n $plugin_inventory ]]; then
    gestalt_agents_version=$(printf '%s' "$plugin_inventory" | read_plugin_version gestalt) ||
      gestalt_agents_version=''
    context_mode_version=$(printf '%s' "$plugin_inventory" | read_plugin_version context-mode) ||
      context_mode_version=''
  fi
  mobile_restart_dir=$gestalt_home/run
  mobile_restart_state=$mobile_restart_dir/mobile-$$.restart
  mkdir -p -- "$mobile_restart_dir"
  mobile_restart_staged=$(mktemp "$mobile_restart_dir/.mobile-$$.XXXXXXXX") ||
    die 'could not stage the Mobile restart descriptor'
  restart_cwd=$(pwd -P) || die 'could not resolve the Mobile working directory'
  {
    printf '%s\0' "$restart_cwd"
    if ((${#forwarded_args[@]} > 0)); then
      printf '%s\0' "${forwarded_args[@]}"
    fi
  } > "$mobile_restart_staged"
  chmod 0600 "$mobile_restart_staged"
  mv -f -- "$mobile_restart_staged" "$mobile_restart_state"
  log "starting Gestalt Mobile from $mobile_root"
  exec env CODEX_HOME="$codex_home" GESTALT_HOME="$gestalt_home" \
    GESTALT_MANAGER_VERSION="$GESTALT_CLI_VERSION" \
    GESTALT_AGENTS_VERSION="$gestalt_agents_version" \
    GESTALT_CONTEXT_MODE_VERSION="$context_mode_version" \
    GESTALT_MOBILE_PID="$$" \
    GESTALT_MOBILE_RESTART_STATE="$mobile_restart_state" \
    GESTALT_STARTUP_DIAGNOSTICS_DONE=1 \
    PATH="$codex_home/bin:$PATH" \
    "$mobile_bin" "${forwarded_args[@]}"
}

print_check() {
  local -r label=$1
  local -r status=$2
  printf '%-24s %s\n' "$label" "$status"
}

read_plugin_version() {
  local -r plugin_name=$1
  # shellcheck disable=SC2016 # The Node program intentionally owns its JavaScript interpolation.
  node -e '
    let input = "";
    const pluginName = process.argv[1];
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", chunk => { input += chunk; });
    process.stdin.on("end", () => {
      const result = JSON.parse(input);
      const installed = Array.isArray(result) ? result : result.installed;
      const plugin = Array.isArray(installed)
        ? installed.find(candidate =>
            candidate && candidate.name === pluginName && candidate.installed !== false)
        : undefined;
      if (!plugin || typeof plugin.version !== "string" || plugin.version.length === 0) {
        process.exitCode = 1;
        return;
      }
      process.stdout.write(plugin.version);
    });
  ' "$plugin_name"
}

context_mode_plugin_source_is_disabled() {
  CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
    node -e '
      let input = "";
      process.stdin.setEncoding("utf8");
      process.stdin.on("data", chunk => { input += chunk; });
      process.stdin.on("end", () => {
        const result = JSON.parse(input);
        const installed = Array.isArray(result) ? result : result.installed;
        const plugin = Array.isArray(installed)
          ? installed.find(candidate => candidate && candidate.name === "context-mode")
          : undefined;
        if (!plugin || plugin.installed === false || plugin.enabled !== false) process.exitCode = 1;
      });
    '
}

context_mode_native_mcp_is_enabled() {
  local -r expected_launcher=$codex_home/bin/context-mode-mcp.mjs

  CODEX_HOME=$codex_home codex mcp get context-mode --json 2>/dev/null |
    node -e '
      let input = "";
      const expectedLauncher = process.argv[1];
      process.stdin.setEncoding("utf8");
      process.stdin.on("data", chunk => { input += chunk; });
      process.stdin.on("end", () => {
        const server = JSON.parse(input);
        const command = server.transport?.command ?? server.command;
        const args = server.transport?.args ?? server.args;
        if (server.enabled !== true || command !== "node" ||
            !Array.isArray(args) || args.length !== 1 || args[0] !== expectedLauncher) {
          process.exitCode = 1;
        }
      });
    ' "$expected_launcher"
}

context_mode_runtime_root() {
  local -r version=$1
  local runtime_identity
  runtime_identity=$(node -p '[process.platform, process.arch, "node-" + process.versions.modules].join("-")') ||
    return 1
  printf '%s/runtime/context-mode/%s/%s\n' "$gestalt_home" "$version" "$runtime_identity"
}

context_mode_runtime_is_prepared() {
  local -r version=$1
  local runtime_root marker
  runtime_root=$(context_mode_runtime_root "$version") || return 1
  marker=$runtime_root/.context-mode-prepared.json
  [[ -f $marker && -f $runtime_root/cli.bundle.mjs && -f $runtime_root/server.bundle.mjs ]] ||
    return 1
  node -e '
    const fs = require("node:fs");
    const marker = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    if (marker.packageVersion !== process.argv[2] ||
        marker.nodeModulesAbi !== process.versions.modules ||
        marker.platform !== process.platform || marker.arch !== process.arch) process.exit(1);
  ' "$marker" "$version"
}

read_supervision_capabilities() {
  local -r component=$1
  local -r manifest=$2

  if [[ ! -f $manifest ]]; then
    printf 'UNAVAILABLE'
    return 0
  fi
  if [[ ! -r $manifest || $(wc -c < "$manifest") -gt 16384 ]]; then
    printf 'MALFORMED'
    return 0
  fi

  # shellcheck disable=SC2016 # The Node program intentionally owns its JavaScript interpolation.
  node -e '
    const fs = require("node:fs");
    const [file, component, schema, contract] = process.argv.slice(1);
    try {
      const value = JSON.parse(fs.readFileSync(file, "utf8"));
      const capabilities = value.capabilities;
      if (!value || typeof value !== "object" || Array.isArray(value) ||
          value.schemaVersion !== Number(schema) || value.component !== component ||
          !Number.isInteger(value.supervisionContract) ||
          !Array.isArray(capabilities) ||
          capabilities.some(capability => typeof capability !== "string" ||
            !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(capability))) {
        process.stdout.write("MALFORMED");
      } else {
        process.stdout.write(`READY|${value.supervisionContract}|${[...new Set(capabilities)].sort().join(",")}`);
      }
    } catch {
      process.stdout.write("MALFORMED");
    }
  ' "$manifest" "$component" "$SUPERVISION_CAPABILITY_SCHEMA" "$SUPERVISION_CONTRACT_VERSION"
}

has_supervision_capability() {
  local -r capabilities=$1
  local -r expected=$2
  [[ ,$capabilities, == *",$expected,"* ]]
}

check_supervision_capability_coherence() {
  local agents mobile agents_contract agents_capabilities mobile_contract mobile_capabilities
  local capability
  local -a agents_required=(supervision-start wait-lease-tool checkpoint-tool agent-capacity-recovery canonical-agent-identity org-plan-contract)
  local -a mobile_required=(supervision-start wait-lease-tool checkpoint-tool agent-capacity-recovery controller-status canonical-agent-identity session-verdict acknowledgement-safe-composer org-plan-contract)

  agents=$(read_supervision_capabilities agents "$agents_capability_manifest")
  mobile=$(read_supervision_capabilities mobile "$mobile_capability_manifest")
  if [[ $agents == UNAVAILABLE ]]; then
    print_check 'Agents supervision' 'UNAVAILABLE (run gestalt update, then restart Mobile)'
    return 1
  fi
  if [[ $mobile == UNAVAILABLE ]]; then
    print_check 'Mobile supervision' 'UNAVAILABLE (run gestalt update, then restart Mobile)'
    return 1
  fi
  if [[ $agents == MALFORMED ]]; then
    print_check 'Agents supervision' 'INCOMPATIBLE (malformed capability manifest; run gestalt update, then restart Mobile)'
    return 1
  fi
  if [[ $mobile == MALFORMED ]]; then
    print_check 'Mobile supervision' 'INCOMPATIBLE (malformed capability manifest; run gestalt update, then restart Mobile)'
    return 1
  fi

  IFS='|' read -r _ agents_contract agents_capabilities <<< "$agents"
  IFS='|' read -r _ mobile_contract mobile_capabilities <<< "$mobile"
  if [[ $agents_contract != "$SUPERVISION_CONTRACT_VERSION" || $mobile_contract != "$SUPERVISION_CONTRACT_VERSION" || $agents_contract != "$mobile_contract" ]]; then
    print_check 'Supervision contract' "INCOMPATIBLE (Agents=$agents_contract Mobile=$mobile_contract; run gestalt update, then restart Mobile)"
    return 1
  fi
  for capability in "${agents_required[@]}"; do
    if ! has_supervision_capability "$agents_capabilities" "$capability"; then
      print_check 'Agents supervision' "INCOMPATIBLE (missing $capability; run gestalt update, then restart Mobile)"
      return 1
    fi
  done
  for capability in "${mobile_required[@]}"; do
    if ! has_supervision_capability "$mobile_capabilities" "$capability"; then
      print_check 'Mobile supervision' "INCOMPATIBLE (missing $capability; run gestalt update, then restart Mobile)"
      return 1
    fi
  done
  print_check 'Supervision contract' "ready (v$agents_contract; offline manifests)"
}

verify_context_mode_installation() {
  local gestalt_version context_version runtime_root
  gestalt_version=$(
    CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
      read_plugin_version gestalt
  ) || die 'Gestalt plugin is not installed after marketplace setup'
  context_version=$(
    CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
      read_plugin_version context-mode
  ) || die 'context-mode plugin is not installed after marketplace setup'
  [[ $context_version == "$gestalt_version" ]] ||
    die "plugin version skew after marketplace setup: gestalt=$gestalt_version context-mode=$context_version"
  runtime_root=$(context_mode_runtime_root "$context_version") ||
    die 'could not resolve the context-mode runtime path'
  context_mode_runtime_is_prepared "$context_version" ||
    die "context-mode $context_version runtime is not prepared: $runtime_root"
  context_mode_plugin_source_is_disabled ||
    die 'context-mode plugin source must remain disabled; run gestalt install or gestalt update to restore the native MCP bridge'
  context_mode_native_mcp_is_enabled ||
    die 'context-mode native MCP bridge is missing or disabled; run gestalt install or gestalt update'
  log "verified context-mode $context_version plugin and external runtime"
}

run_doctor_command() {
  local -r label=$1
  shift
  printf '\n%s\n' "$label"
  if "$@"; then
    return 0
  fi
  log "$label reported a problem"
  return 1
}

run_startup_diagnostics() {
  log 'running startup diagnostics'
  if ! command_doctor; then
    log 'startup diagnostics reported a problem; launch will continue after required runtime checks'
  fi
}

command_doctor() {
  local failed=false node_version codex_version gestalt_plugin_version
  local context_mode_plugin_version context_mode_runtime mobile_version_output

  printf 'Gestalt manager %s\n\n' "$GESTALT_CLI_VERSION"
  print_check 'Codex home' "$codex_home"
  print_check 'Gestalt home' "$gestalt_home"

  if command -v node >/dev/null 2>&1; then
    node_version=$(node -p 'process.versions.node' 2>/dev/null || printf 'unreadable')
    print_check 'Node.js' "$node_version"
    [[ ${node_version%%.*} =~ ^[0-9]+$ ]] && (( ${node_version%%.*} >= 24 )) || failed=true
  else
    print_check 'Node.js' 'MISSING (24+ required)'
    failed=true
  fi

  if command -v npm >/dev/null 2>&1; then
    print_check 'npm' "$(npm --version 2>/dev/null || printf 'unreadable')"
  else
    print_check 'npm' 'MISSING'
    failed=true
  fi

  if command -v codex >/dev/null 2>&1; then
    codex_version=$(codex --version 2>/dev/null || printf 'unreadable')
    print_check 'Codex CLI' "$codex_version"
  else
    print_check 'Codex CLI' 'MISSING'
    failed=true
  fi

  if [[ -f $marketplace_setup ]]; then
    print_check 'Agents marketplace' 'present'
  else
    print_check 'Agents marketplace' 'MISSING'
    failed=true
  fi

  if command -v codex >/dev/null 2>&1 && [[ -d $codex_home ]]; then
    if gestalt_plugin_version=$(
      CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
        read_plugin_version gestalt 2>/dev/null
    ); then
      print_check 'Gestalt plugins' "$gestalt_plugin_version"
    else
      print_check 'Gestalt plugins' 'NOT VERIFIED'
      failed=true
    fi
    if context_mode_plugin_version=$(
      CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
        read_plugin_version context-mode 2>/dev/null
    ); then
      print_check 'Context-mode plugin' "$context_mode_plugin_version"
      if [[ -n ${gestalt_plugin_version:-} &&
            $context_mode_plugin_version != "$gestalt_plugin_version" ]]; then
        print_check 'Plugin version match' \
          "MISMATCH (gestalt=$gestalt_plugin_version context-mode=$context_mode_plugin_version)"
        failed=true
      elif context_mode_runtime_is_prepared "$context_mode_plugin_version"; then
        context_mode_runtime=$(context_mode_runtime_root "$context_mode_plugin_version")
        print_check 'Context-mode runtime' "$context_mode_runtime"
      else
        context_mode_runtime=$(context_mode_runtime_root "$context_mode_plugin_version" || printf 'unresolved')
        print_check 'Context-mode runtime' "NOT PREPARED ($context_mode_runtime)"
        failed=true
      fi
      if context_mode_plugin_source_is_disabled; then
        print_check 'Plugin MCP source' 'disabled (expected)'
      else
        print_check 'Plugin MCP source' 'ENABLED (disable it; native bridge owns startup)'
        failed=true
      fi
      if context_mode_native_mcp_is_enabled; then
        print_check 'Native context MCP' 'enabled'
      else
        print_check 'Native context MCP' 'MISSING OR DISABLED'
        failed=true
      fi
    else
      print_check 'Context-mode plugin' 'NOT VERIFIED'
      failed=true
    fi
  fi

  if [[ -x $mobile_bin ]]; then
    mobile_version_output=$(CODEX_HOME=$codex_home "$mobile_bin" --version 2>/dev/null || printf 'unreadable')
    print_check 'Gestalt Mobile' "$mobile_version_output"
  else
    print_check 'Gestalt Mobile' 'MISSING'
    failed=true
  fi

  check_supervision_capability_coherence || failed=true

  if command -v codex >/dev/null 2>&1; then
    run_doctor_command 'Codex doctor' \
      env CODEX_HOME="$codex_home" codex doctor --summary --ascii --no-color || failed=true
  fi

  if [[ -n ${context_mode_runtime:-} && -f $context_mode_runtime/cli.bundle.mjs ]]; then
    run_doctor_command 'Context-mode doctor' \
      env CODEX_HOME="$codex_home" GESTALT_HOME="$gestalt_home" \
      CONTEXT_MODE_PLATFORM=codex CONTEXT_MODE_WORKSPACE="$PWD" \
      node "$context_mode_runtime/cli.bundle.mjs" doctor || failed=true
  fi

  if "$failed"; then
    printf "\nRun 'gestalt install' or 'gestalt update' to repair missing components.\n" >&2
    return 1
  fi
  printf "\nAll startup diagnostics passed.\n"
}

main() {
  local command_name=${1:-help}
  if (($# > 0)); then shift; fi

  load_paths
  case $command_name in
    install) command_install "$@" ;;
    update) command_update "$@" ;;
    update-restart) command_update_restart "$@" ;;
    __update-restart-worker) command_update_restart_worker "$@" ;;
    cli) command_cli "$@" ;;
    mobile) command_mobile "$@" ;;
    skills-export) command_skills_export "$@" ;;
    skills-import) command_skills_import "$@" ;;
    doctor) command_doctor "$@" ;;
    version | --version | -V) printf 'gestalt %s\n' "$GESTALT_CLI_VERSION" ;;
    help | --help | -h) usage ;;
    *) die "unknown command: $command_name (run 'gestalt help')" ;;
  esac
}

main "$@"
