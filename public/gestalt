    project['ignored_paths'] = list(dict.fromkeys([*(project.get('ignored_paths') or []), '.gestalt/**']))
    save(project_path, project)
    lock.close()
except Exception as error:
    sys.stderr.write('gestalt: Serena workspace preparation failed: ' + str(error) + '\n')
    sys.exit(1)
os.execve(executable, [executable, *sys.argv[4:]], os.environ)
PYTHON
}

# Own native descendants independently of the SDK's detached stdio process.
serena_operator_supervisor() {
  cat <<'JS'
const {spawn}=require('node:child_process');
const child=spawn(process.argv[1],JSON.parse(process.argv[2]),{env:process.env,detached:true,stdio:['pipe','inherit','inherit']});
let ending=false,code=0;
function stop(){if(ending)return;ending=true;try{process.kill(-child.pid,'SIGTERM');}catch{}setTimeout(()=>{try{process.kill(-child.pid,'SIGKILL');}catch{}process.exit(code);},500);}
process.stdin.pipe(child.stdin);child.stdin.on('error',()=>{});
process.stdin.on('end',stop);process.on('SIGTERM',stop);process.on('SIGINT',stop);
child.on('error',()=>process.exit(1));child.on('exit',value=>{if(!ending)code=value??1;stop();});
JS
}

run_serena_install_process() {
  node -e '
const {spawn}=require("node:child_process");
const child=spawn(process.argv[1],process.argv.slice(2),{env:process.env,detached:true,stdio:["ignore","inherit","inherit"]});
let ending=false,code=0;
function stop(){if(ending)return;ending=true;try{process.kill(-child.pid,"SIGTERM");}catch{}setTimeout(()=>{try{process.kill(-child.pid,"SIGKILL");}catch{}process.exit(code);},500);}
process.on("SIGTERM",()=>{code=143;stop();});process.on("SIGINT",()=>{code=130;stop();});
child.on("error",()=>process.exit(1));child.on("exit",value=>{if(!ending)code=value??1;stop();});
' "$@" &
  serena_install_process_pid=$!
  wait "$serena_install_process_pid"
  serena_install_process_pid=''
}

install_serena() {
  local version=${1:-$MANAGED_SERENA_VERSION} os cpu target asset base expected actual listing candidate
  [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die 'Serena release must be a stable VERSION (major.minor.patch)'
  require_command node
  require_command curl
  require_command tar
  require_command mktemp
  os=$(uname -s)
  cpu=$(uname -m)
  case $cpu in
    x86_64 | amd64) cpu=x86_64 ;;
    aarch64 | arm64) cpu=aarch64 ;;
    *) die "unsupported Serena CPU: $cpu" ;;
  esac
  case $os in
    Linux) target=$cpu-unknown-linux-gnu ;;
    Darwin) target=$cpu-apple-darwin ;;
    *) die "managed Serena supports Linux and macOS, not $os" ;;
  esac
  validate_xerj_path "$gestalt_home/serena"
  umask 077
  mkdir -p -- "$gestalt_home/serena"
  mkdir -- "$gestalt_home/serena/.install-lock" 2>/dev/null ||
    die 'Serena install already running (after a killed installer, verify it exited before removing .install-lock)'
  serena_install_lock=$gestalt_home/serena/.install-lock
  trap 'exit 130' INT
  trap 'exit 143' TERM
  # Construct at the final path: uv environments contain absolute interpreter paths.
  serena_install_candidate=$(mktemp -d "$gestalt_home/serena/release-$version.XXXXXXXX")
  candidate=$serena_install_candidate
  mkdir -- "$candidate/bin" "$candidate/home" "$candidate/tmp"
  asset=uv-$target.tar.gz
  base=https://github.com/astral-sh/uv/releases/download/$MANAGED_UV_VERSION
  curl -q --fail --location --silent --show-error --proto '=https' --proto-redir '=https' \
    --connect-timeout 20 --max-time 120 "$base/$asset" --output "$candidate/uv.tar.gz"
  curl -q --fail --location --silent --show-error --proto '=https' --proto-redir '=https' \
    --connect-timeout 20 --max-time 120 "$base/$asset.sha256" --output "$candidate/uv.sha256"
  IFS=' ' read -r expected _ < "$candidate/uv.sha256" || die 'missing uv checksum'
  [[ $expected =~ ^[[:xdigit:]]{64}$ ]] || die 'invalid uv checksum'
  actual=$(calculate_sha256 "$candidate/uv.tar.gz")
  actual=${actual%% *}
  actual=$(printf '%s' "$actual" | tr 'A-F' 'a-f')
  expected=$(printf '%s' "$expected" | tr 'A-F' 'a-f')
  [[ $actual == "$expected" ]] || die 'uv checksum mismatch; prior Serena installation preserved'
  unset TAR_OPTIONS GZIP
  listing=$(tar -tvzf "$candidate/uv.tar.gz" "uv-$target/uv")
  [[ $listing == -* && $listing != *$'\n'* ]] || die 'uv archive must contain one regular binary'
  tar -xOzf "$candidate/uv.tar.gz" "uv-$target/uv" > "$candidate/bin/uv"
  chmod 0755 "$candidate/bin/uv"
  case $("$candidate/bin/uv" --version) in
    "uv $MANAGED_UV_VERSION" | "uv $MANAGED_UV_VERSION ("*")") ;;
    *) die 'downloaded uv version mismatch' ;;
  esac
  # All installation writes are private. Never invoke the uv installer or modify profiles.
  run_serena_install_process env HOME="$candidate/home" TMPDIR="$candidate/tmp" UV_TOOL_DIR="$candidate/tools" \
    UV_TOOL_BIN_DIR="$candidate/bin" UV_CACHE_DIR="$candidate/cache" UV_PYTHON_INSTALL_DIR="$candidate/python" \
    UV_PYTHON_BIN_DIR="$candidate/bin" UV_NO_PROGRESS=1 UV_NO_CONFIG=1 \
    "$candidate/bin/uv" python install 3.13 --no-bin </dev/null
  run_serena_install_process env HOME="$candidate/home" TMPDIR="$candidate/tmp" UV_TOOL_DIR="$candidate/tools" \
    UV_TOOL_BIN_DIR="$candidate/bin" UV_CACHE_DIR="$candidate/cache" UV_PYTHON_INSTALL_DIR="$candidate/python" \
    UV_PYTHON_DOWNLOADS=never UV_NO_PROGRESS=1 UV_NO_CONFIG=1 \
    "$candidate/bin/uv" tool install --managed-python --python 3.13 "serena-agent==$version" </dev/null
  [[ -x $candidate/bin/serena && -x $candidate/tools/serena-agent/bin/python ]] || die 'Serena installation has missing executables'
  HOME="$candidate/home" TMPDIR="$candidate/tmp" SERENA_HOME="$candidate/probe" \
    GESTALT_SERENA_PREPARE="$(serena_workspace_prepare)" GESTALT_SERENA_NODE="$(command -v node)" \
    GESTALT_SERENA_SUPERVISOR="$(serena_operator_supervisor)" \
    PYTHONDONTWRITEBYTECODE=1 UV_TOOL_DIR="$candidate/tools" UV_TOOL_BIN_DIR="$candidate/bin" \
    UV_CACHE_DIR="$candidate/cache" UV_PYTHON_INSTALL_DIR="$candidate/python" UV_PYTHON_DOWNLOADS=never \
    "$candidate/tools/serena-agent/bin/python" - "$candidate" "$version" <<'PYTHON'
import asyncio, importlib.metadata, json, os, pathlib, subprocess, sys
from mcp import ClientSession, StdioServerParameters
from mcp.client.stdio import stdio_client
root = pathlib.Path(sys.argv[1])
version = importlib.metadata.version('serena-agent')
if version != sys.argv[2] or sys.version_info[:2] != (3, 13):
    raise RuntimeError('Serena package or managed Python version mismatch')
executable = root / 'bin' / 'serena'
settings = dict(python=str(root / 'tools/serena-agent/bin/python'), uv=str(root / 'bin/uv'), pythonInstallDir=str(root / 'python'))
# Existing workspace uv caches may refer to a retained release's interpreter.
# Validate those precise immutable targets; never admit a shared directory or arbitrary state link.
interpreters = {str(pathlib.Path(settings['python']).resolve())}
for release in root.parent.glob('release-*'):
    previous_python = release / 'tools/serena-agent/bin/python'
    if release.is_symlink() or not previous_python.is_file():
        continue
    probe = subprocess.run([str(previous_python), '-I', '-B', '-c',
        'import importlib.metadata, json, sys; print(json.dumps({"serena":importlib.metadata.version("serena-agent"),"python":".".join(map(str,sys.version_info[:3]))}))'],
        capture_output=True, text=True, timeout=5)
    try:
        identity = json.loads(probe.stdout)
        if probe.returncode == 0 and identity['python'].startswith('3.13.') and release.name.startswith('release-' + identity['serena'] + '.'):
            resolved = previous_python.resolve()
            if resolved.is_relative_to(release / 'python'):
                interpreters.add(str(resolved))
    except (ValueError, KeyError, TypeError):
        pass
settings['pythonExecutables'] = sorted(interpreters)
workspace = root / 'probe-workspace'
workspace.mkdir()
(workspace / 'example.py').write_text('def managed_probe():\n    return 1\n')
preparation = os.environ['GESTALT_SERENA_PREPARE']
# Exercise the release's native configuration APIs and project storage relocation.
subprocess.run([sys.executable, '-c', preparation, str(workspace), str(executable), json.dumps(settings), '--help'],
    check=True, timeout=20, stdout=subprocess.DEVNULL)
if not (workspace / '.gestalt/serena/project.yml').is_file() or (workspace / '.serena').exists():
    raise RuntimeError('incompatible Serena workspace storage contract')
help_text = subprocess.check_output([str(executable), 'start-mcp-server', '--help'], timeout=15, text=True)
for option in ('--context', '--mode', '--project', '--enable-web-dashboard', '--enable-gui-log-window'):
    if option not in help_text:
        raise RuntimeError('incompatible Serena CLI: missing ' + option)
async def catalog():
    parameters = StdioServerParameters(command=sys.executable, args=['-c', preparation, str(workspace), str(executable),
        json.dumps(settings), 'start-mcp-server', '--context', 'codex', '--mode', 'editing', '--project', str(workspace),
        '--enable-web-dashboard', 'false', '--open-web-dashboard', 'false', '--enable-gui-log-window', 'false'], env=dict(os.environ))
    parameters = StdioServerParameters(command=os.environ['GESTALT_SERENA_NODE'],
        args=['-e',os.environ['GESTALT_SERENA_SUPERVISOR'],parameters.command,json.dumps(parameters.args)],env=parameters.env)
    async with stdio_client(parameters) as (reader, writer):
        async with ClientSession(reader, writer) as session:
            await session.initialize()
            return [tool.model_dump(mode='json', exclude_none=True) for tool in (await session.list_tools()).tools]
tools = asyncio.run(asyncio.wait_for(catalog(), timeout=30))
required = {'get_symbols_overview', 'find_symbol', 'initial_instructions', 'replace_symbol_body', 'insert_after_symbol', 'write_memory'}
if not required.issubset({tool['name'] for tool in tools}):
    raise RuntimeError('incomplete Serena Codex editing tool contract')
# Keep the venv Python path, not its symlink target: it selects installed packages.
descriptor = dict(schemaVersion=1, contractVersion=1, version=version, executable=str(executable),
    python=str(root / 'tools/serena-agent/bin/python'), uv=str(root / 'bin/uv'),
    pythonInstallDir=str(root / 'python'), pythonExecutables=settings['pythonExecutables'], tools=tools)
(root / 'active.json').write_text(json.dumps(descriptor) + '\n')
PYTHON
  mv -f -- "$candidate/active.json" "$gestalt_home/serena/active.json"
  # Keep candidate and old releases; a live session may still own the old executable.
  serena_install_candidate=''
  rm -rf -- "$candidate/probe" "$candidate/probe-workspace" "${candidate:?}/home" "$candidate/tmp" "$candidate/cache"
  rm -f -- "$candidate/uv.tar.gz" "$candidate/uv.sha256"
  log "installed Serena $version with uv $MANAGED_UV_VERSION and Python 3.13"
}

command_serena() {
  local action=${1:-help}
  if (($#)); then shift; fi
  case $action in
    help | -h | --help)
      (($# == 0)) || die 'usage: gestalt serena help'
      cat <<'EOF'
Usage: gestalt serena <command> [options]

Commands:
  install                    Install private uv, Python 3.13 and tested Serena.
  update [VERSION]           Validate and activate a release; retain prior tooling.
  version                    Read the installed version without starting Serena.
  doctor [--cwd ROOT] [--json] Check installation and optional workspace readiness.
  index --cwd ROOT           Warm symbol and language caches for a project.
  mcp --cwd ROOT             Start the workspace MCP stdio connection.

Install once with 'gestalt serena install'. Codex and Mobile start the MCP
connection for selected workspaces when the Serena skill is enabled.
Use 'gestalt serena mcp --cwd /absolute/project/path' for an MCP client;
the command speaks JSON-RPC over stdin/stdout and runs until the client exits.
EOF
      ;;
    install)
      (($# == 0)) || die 'usage: gestalt serena install'
      if [[ -f $gestalt_home/serena/active.json ]] && serena_install_valid; then
        log 'Serena already installed and validated'
      else
        install_serena
      fi
      ;;
    update)
      (($# <= 1)) || die 'usage: gestalt serena update [VERSION]'
      local version=${1:-latest}
      if [[ $version == latest ]]; then
        require_command curl
        require_command node
        version=$(curl -q --fail --location --silent --show-error --proto '=https' --proto-redir '=https' \
          --connect-timeout 20 --max-time 30 https://pypi.org/pypi/serena-agent/json | \
          node -e 'let s=""; process.stdin.on("data",b=>s+=b); process.stdin.on("end",()=>{const d=JSON.parse(s);const versions=Object.keys(d.releases??{}).filter(v=>/^\d+\.\d+\.\d+$/.test(v)&&d.releases[v]?.some(f=>!f.yanked)).sort((a,b)=>{const x=a.split(".").map(Number),y=b.split(".").map(Number);return x[0]-y[0]||x[1]-y[1]||x[2]-y[2];});if(!versions.length)process.exit(1);process.stdout.write(versions.at(-1));});') ||
          die 'could not resolve the latest stable Serena release; prior installation preserved'
      fi
      install_serena "$version"
      ;;
    mcp)
      [[ $# == 2 && $1 == --cwd && -n $2 ]] || die 'usage: gestalt serena mcp --cwd ROOT; context, mode and project cannot be overridden'
      require_command node
      require_command codex
      [[ -d $2 ]] || die 'Serena workspace must be an existing directory'
      [[ -f $gestalt_home/serena/active.json ]] || die 'Serena is not installed; run gestalt serena install'
      GESTALT_SERENA_PREPARE="$(serena_workspace_prepare)" GESTALT_SERENA_WORKSPACE=$2 GESTALT_SERENA_INSTALL=$gestalt_home/serena/active.json run_serena_proxy
      ;;
    version | -V | --version)
      (($# == 0)) || die 'usage: gestalt serena version'
      local value
      value=$(serena_versions serena) || die 'Serena installation absent or invalid; run gestalt serena install'
      printf 'serena %s\n' "$value"
      ;;
    doctor | index)
      local workspace='' json_output=false
      while (($#)); do
        case $1 in
          --cwd) [[ $# -ge 2 && -d $2 ]] || die 'Serena --cwd requires an existing directory'; workspace=$2; shift 2 ;;
          --json) [[ $action == doctor ]] || die '--json is only supported for Serena doctor'; json_output=true; shift ;;
          *) die 'usage: gestalt serena doctor [--cwd ROOT] [--json] | index --cwd ROOT' ;;
        esac
      done
      [[ $action != index || -n $workspace ]] || die 'usage: gestalt serena index --cwd ROOT'
      serena_operator "$action" "$workspace" "$json_output"
      ;;
    *) die 'usage: gestalt serena install | update [VERSION] | version | doctor [--cwd ROOT] | index --cwd ROOT | mcp --cwd ROOT' ;;
  esac
}

