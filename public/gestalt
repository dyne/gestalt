  {
    printf '%s\0' "$restart_cwd"
    if ((${#forwarded_args[@]} > 0)); then
      printf '%s\0' "${forwarded_args[@]}"
    fi
  } > "$mobile_restart_staged"
  chmod 0600 "$mobile_restart_staged"
  mv -f -- "$mobile_restart_staged" "$mobile_restart_state"
  resolve_manager_target
  log "starting Gestalt Mobile from $mobile_root"
  exec env CODEX_HOME="$codex_home" GESTALT_HOME="$gestalt_home" \
    GESTALT_MANAGER_BIN="$manager_target" \
    GESTALT_MANAGER_VERSION="$GESTALT_CLI_VERSION" \
    GESTALT_AGENTS_VERSION="$gestalt_agents_version" \
    GESTALT_AGENTS_PLUGIN_ROOT="$gestalt_plugin_root" \
    GESTALT_CONTEXT_MODE_VERSION="$context_mode_version" \
    GESTALT_XERJ_VERSION="$(installed_xerj_version)" \
    GESTALT_SERENA_VERSION="$(serena_versions serena 2>/dev/null || true)" \
    GESTALT_UV_VERSION="$(serena_versions uv 2>/dev/null || true)" \
    GESTALT_SERENA_PYTHON_VERSION="$(serena_versions python 2>/dev/null || true)" \
