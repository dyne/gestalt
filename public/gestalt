# Metadata reads never import Serena (its version flag initializes ~/.serena).
serena_versions() {
  command -v node >/dev/null 2>&1 || return 1
  node - "$gestalt_home/serena/active.json" "${1:-json}" <<'JS'
const fs = require('node:fs'), {spawnSync} = require('node:child_process');
try {
  const d = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
  if (d.schemaVersion !== 1 || (d.contractVersion !== 1 && d.version !== '1.7.0') || !/^\d+\.\d+\.\d+$/.test(d.version) ||
      !Array.isArray(d.tools) || !['find_symbol','get_symbols_overview','replace_symbol_body'].every(n => d.tools.some(t => t.name === n && t.inputSchema))) throw Error();
  for (const p of [d.python, d.executable, d.uv]) fs.accessSync(p, fs.constants.X_OK);
  if (!fs.statSync(d.pythonInstallDir).isDirectory()) throw Error();
  const py = spawnSync(d.python, ['-I', '-B', '-c',
    'import importlib.metadata, json, sys; print(json.dumps({"serena":importlib.metadata.version("serena-agent"),"python":".".join(map(str,sys.version_info[:3]))}))'],
    {encoding:'utf8',timeout:5000,maxBuffer:65536});
  const uv = spawnSync(d.uv,['--version'],{encoding:'utf8',timeout:5000,maxBuffer:65536});
  if (py.status !== 0 || uv.status !== 0) throw Error('metadata runtime failure');
  const value = JSON.parse(py.stdout), match = uv.stdout.trim().match(/^uv (\d+\.\d+\.\d+)(?:[ (]|$)/);
  if (value.serena !== d.version || !/^3\.13\.\d+$/.test(value.python) || !match) throw Error('metadata identity mismatch');
  value.uv = match[1];
  console.log(process.argv[3] === 'serena' ? value.serena : process.argv[3] === 'uv' ? value.uv : process.argv[3] === 'python' ? value.python : JSON.stringify(value));
} catch (error) { console.error('gestalt: Serena versions: ' + (error.message || 'invalid installation')); process.exit(1); }
JS
}

codex_sandbox_probe() {
  node --input-type=module - <<'JS'
import { readFile, realpath, mkdtemp, rm, access } from 'node:fs/promises';
import { constants } from 'node:fs';
import { spawn, spawnSync } from 'node:child_process';
import { createRequire } from 'node:module';
import { tmpdir } from 'node:os';
import { join, dirname, delimiter } from 'node:path';
const report = { ready: false, reason: 'codex-not-found', bubblewrap: null, userNamespaces: {} };
const executable = async path => { try { await access(path, constants.X_OK); return await realpath(path); } catch { return null; } };
const find = async name => {
  for (const directory of (process.env.PATH ?? '').split(delimiter)) {
    const path = await executable(join(directory || '.', name));
    if (path) return path;
  }
  return null;
};
let temporary, child, timer, signal;
try {
  const codex = await find('codex');
  if (process.platform === 'linux') {
    for (const name of ['kernel.unprivileged_userns_clone', 'kernel.apparmor_restrict_unprivileged_userns', 'user.max_user_namespaces']) {
      try { report.userNamespaces[name] = (await readFile('/proc/sys/' + name.replaceAll('.', '/'), 'utf8')).trim(); }
      catch { report.userNamespaces[name] = null; }
    }
    let bwrap = await find('bwrap'), source = 'system';
    if (!bwrap && codex) {
      const candidates = [join(dirname(codex), '../codex-resources/bwrap'), join(dirname(codex), 'codex-resources/bwrap')];
      if (['x64', 'arm64'].includes(process.arch)) {
        const triple = (process.arch === 'x64' ? 'x86_64' : 'aarch64') + '-unknown-linux-musl';
        try {
          const packagePath = createRequire(codex).resolve('@openai/codex-linux-' + process.arch + '/package.json');
          candidates.push(join(dirname(packagePath), 'vendor', triple, 'codex-resources/bwrap'));
        } catch {}
        candidates.push(join(dirname(codex), '../vendor', triple, 'codex-resources/bwrap'));
      }
      for (const candidate of candidates) { bwrap = await executable(candidate); if (bwrap) break; }
      source = 'bundled';
    }
    if (bwrap) {
      const version = spawnSync(bwrap, ['--version'], { encoding: 'utf8', timeout: 1000, maxBuffer: 4096 });
      report.bubblewrap = { available: version.status === 0, path: bwrap, source, version: version.status === 0 ? version.stdout.trim() : null };
    } else report.bubblewrap = { available: false, path: null, source: null, version: null };
  }
  if (codex) {
    temporary = await mkdtemp(join(tmpdir(), 'gestalt-sandbox-doctor-'));
    let stderr = '', timedOut = false;
    child = spawn(codex, ['-c', 'default_permissions=":read-only"', 'sandbox', '--', '/bin/true'],
      { detached: true, env: { ...process.env, CODEX_HOME: temporary }, stdio: ['ignore', 'ignore', 'pipe'] });
    const kill = kind => { if (child?.pid) { try { process.kill(-child.pid, kind); } catch {} } };
    signal = () => kill('SIGKILL');
    process.on('SIGINT', signal); process.on('SIGTERM', signal);
    child.stderr.on('data', data => { stderr = (stderr + data).slice(-4096); });
    timer = setTimeout(() => { timedOut = true; kill('SIGKILL'); }, 5000);
    const result = await new Promise(resolve => {
      child.once('error', error => resolve({ error })); child.once('close', code => resolve({ code }));
    });
    clearTimeout(timer); kill('SIGKILL');
    report.ready = result.code === 0 && !timedOut;
    report.reason = timedOut ? 'sandbox-timeout' : report.ready ? 'ready' : 'sandbox-startup-failed';
    if (!report.ready) report.diagnostic = (stderr.trim() || result.error?.message || 'Codex sandbox exited with code ' + result.code).slice(-4096);
  }
} catch (error) { report.reason = 'sandbox-probe-failed'; report.diagnostic = error.message; }
finally {
  clearTimeout(timer);
  if (signal) { process.off('SIGINT', signal); process.off('SIGTERM', signal); }
  if (temporary) await rm(temporary, { recursive: true, force: true });
}
console.log(JSON.stringify(report));
JS
}

command_sandbox_doctor() {
  require_command node
  doctor_sandbox_report=$(codex_sandbox_probe)
  node --input-type=module - "$doctor_sandbox_report" <<'JS'
const report = JSON.parse(process.argv[2]);
if (report.bubblewrap) {
  console.log('Bubblewrap'.padEnd(24) + (report.bubblewrap.available
    ? report.bubblewrap.version + ' (' + report.bubblewrap.source + ')'
    : 'not found or unusable; check the Codex installation'));
}
for (const [name, value] of Object.entries(report.userNamespaces)) console.log(name + ' = ' + (value ?? 'unavailable'));
console.log('Codex sandbox'.padEnd(24) + (report.ready ? 'ready' : report.reason));
if (!report.ready) {
  if (report.diagnostic) console.log(report.diagnostic);
  console.log('Check Bubblewrap and unprivileged user namespaces, including Ubuntu AppArmor restrictions.');
}
process.exitCode = report.ready ? 0 : 1;
JS
}

serena_operator() {
  local action=$1 workspace=$2 json_output=$3 sandbox_report=''
  require_command node
  if [[ $action == doctor ]]; then
    sandbox_report=${doctor_sandbox_report:-$(codex_sandbox_probe)}
  fi
  GESTALT_SERENA_SANDBOX_REPORT=$sandbox_report \
    GESTALT_SERENA_PREPARE="$(serena_workspace_prepare)" GESTALT_SERENA_NODE="$(command -v node)" \
    GESTALT_SERENA_SUPERVISOR="$(serena_operator_supervisor)" \
    node --input-type=module - "$gestalt_home/serena/active.json" "$action" "$workspace" "$json_output" <<'JS'
import { readFile, realpath, mkdtemp, mkdir, rm, access, stat } from 'node:fs/promises';
import { constants } from 'node:fs';
import { spawn, spawnSync } from 'node:child_process';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
const [descriptor, action, directory, jsonOutput] = process.argv.slice(2);
const sandbox = action === 'doctor' ? JSON.parse(process.env.GESTALT_SERENA_SANDBOX_REPORT) : null;
let report = {installed:false,connected:false,projectReady:null,reason:'not-installed', ...(sandbox ? { sandbox } : {})};
