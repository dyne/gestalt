install_mobile() {
  check_node_version
  require_command npm
  mkdir -p -- "$mobile_root"
  log "installing gestalt-mobile@${mobile_version} under $mobile_root"
  npm install \
    --prefix "$mobile_root" \
    --no-audit \
    --no-fund \
    --save-exact \
    "gestalt-mobile@${mobile_version}"
  [[ -x $mobile_bin ]] || die "npm completed but the Mobile executable is missing: $mobile_bin"
}

run_marketplace_setup() {
  local -r mode=$1
  local -r include_extra_skills=$2
  local marketplace_action
  local -a setup_args=()

  check_node_version
  require_command npm
  require_command codex
  mkdir -p -- "$codex_home" "$gestalt_home"
  configure_codex_permissions

  marketplace_action=upgrade
  if [[ $mode == install && ! -f $marketplace_setup ]]; then
    marketplace_action=add
  fi

  log "${marketplace_action} marketplace $marketplace in $codex_home"
  if [[ $marketplace_action == add ]]; then
    if ! CODEX_HOME=$codex_home codex plugin marketplace add "$marketplace"; then
      log 'marketplace is already registered; attempting an upgrade'
      CODEX_HOME=$codex_home codex plugin marketplace upgrade "$marketplace_name"
    fi
  else
    if ! CODEX_HOME=$codex_home codex plugin marketplace upgrade "$marketplace_name"; then
      log 'marketplace upgrade was unavailable; attempting a fresh registration'
      CODEX_HOME=$codex_home codex plugin marketplace add "$marketplace"
    fi
  fi

  [[ -f $marketplace_setup ]] ||
    die "marketplace setup script is missing after ${marketplace_action}: $marketplace_setup"

  if [[ $include_extra_skills == true ]]; then
    setup_args+=(--extra-skills)
  fi

  log 'preparing context mode, plugins, and agent profiles'
  CODEX_HOME=$codex_home GESTALT_HOME=$gestalt_home \
    bash "$marketplace_setup" "${setup_args[@]}"
  verify_context_mode_installation
  configure_codex_tool_approvals
}

parse_setup_options() {
  include_extra_skills=false
  while (($# > 0)); do
    case $1 in
      --extra-skills)
        include_extra_skills=true
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        die "unknown setup option: $1"
        ;;
    esac
    shift
  done
}

command_install() {
  parse_setup_options "$@"
  run_marketplace_setup install "$include_extra_skills"
  install_mobile
  log "installation complete; run 'gestalt doctor', then 'gestalt cli' or 'gestalt mobile'"
}

command_update() {
  parse_setup_options "$@"
  update_manager
  run_marketplace_setup upgrade "$include_extra_skills"
  install_mobile
  log 'manager, Agents, and Mobile are up to date'
}

resolve_manager_target() {
  local manager_source manager_dir manager_name

  manager_source=${BASH_SOURCE[0]}
  manager_dir=$(CDPATH='' cd -- "$(dirname -- "$manager_source")" && pwd -P) ||
    die "could not resolve manager directory: $manager_source"
  manager_name=$(basename -- "$manager_source")
  manager_target=$manager_dir/$manager_name
  [[ -x $manager_target ]] || die "manager executable is unavailable: $manager_target"
}

validate_mobile_restart_context() {
  local -r relay_pid=$1
  local -r restart_state=$2
  local -r expected_state=$gestalt_home/run/mobile-$relay_pid.restart

  [[ $relay_pid =~ ^[1-9][0-9]*$ ]] ||
    die 'update-restart must be run from a session managed by Gestalt Mobile'
  [[ $restart_state == "$expected_state" && -r $restart_state ]] ||
    die 'the Gestalt Mobile restart descriptor is unavailable or invalid'
  process_is_live "$relay_pid" || die 'the managing Gestalt Mobile process is not running'
}

process_is_live() {
  local -r process_pid=$1
  local process_state

  kill -0 "$process_pid" 2>/dev/null || return 1
  process_state=$(ps -o stat= -p "$process_pid" 2>/dev/null) || return 1
  process_state=${process_state//[[:space:]]/}
  [[ $process_state != Z* ]]
}

command_update_restart() {
  local relay_pid restart_state restart_log restart_lock worker_pid manager_target

  parse_setup_options "$@"
  relay_pid=${GESTALT_MOBILE_PID:-}
  restart_state=${GESTALT_MOBILE_RESTART_STATE:-}
  validate_mobile_restart_context "$relay_pid" "$restart_state"
  check_node_version
  resolve_manager_target
  restart_log=$gestalt_home/update-restart.log
  restart_lock=$gestalt_home/run/update-restart.lock
  mkdir -- "$restart_lock" 2>/dev/null ||
    die "another update-restart is already running ($restart_lock)"

  if ! worker_pid=$(node -e '
    const { spawn } = require("node:child_process");
    const [command, ...args] = process.argv.slice(1);
    const child = spawn(command, args, {
      detached: true,
      env: process.env,
      stdio: "ignore",
    });
    child.unref();
    process.stdout.write(String(child.pid));
  ' "$manager_target" __update-restart-worker \
    "$relay_pid" "$restart_state" "$include_extra_skills" "$restart_log" "$restart_lock"); then
    rmdir -- "$restart_lock" 2>/dev/null || true
    die 'could not schedule the detached update and restart worker'
  fi
  if [[ ! $worker_pid =~ ^[1-9][0-9]*$ ]]; then
    rmdir -- "$restart_lock" 2>/dev/null || true
    die 'the detached update worker did not start'
  fi

  log "scheduled update and Mobile restart (worker $worker_pid)"
  log "progress will be written to $restart_log; this session will reconnect after restart"
}

command_update_restart_worker() {
  local -r relay_pid=${1:-}
  local -r restart_state=${2:-}
  local -r worker_extra_skills=${3:-false}
  local -r restart_log=${4:-}
  local -r restart_lock=${5:-}
  local restart_cwd restart_field manager_target
  local -a restart_record restart_args update_args=()

  [[ -n $restart_log ]] || die 'the update-restart worker log path is missing'
  validate_managed_path 'update-restart log' "$restart_log"
  [[ $restart_lock == "$gestalt_home/run/update-restart.lock" && -d $restart_lock ]] ||
    die 'the update-restart worker lock is unavailable or invalid'
  update_restart_lock=$restart_lock
  mkdir -p -- "$(dirname -- "$restart_log")"
  exec >> "$restart_log" 2>&1

  log "starting live update at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  # Let a calling Mobile endpoint flush its accepted response before any fast,
  # already-current update reaches the relay shutdown step.
  sleep 1
  validate_mobile_restart_context "$relay_pid" "$restart_state"
  while IFS= read -r -d '' restart_field; do
    restart_record+=("$restart_field")
  done < "$restart_state"
  ((${#restart_record[@]} >= 1)) || die 'the Gestalt Mobile restart descriptor is empty'
  restart_cwd=${restart_record[0]}
  restart_args=("${restart_record[@]:1}")
  [[ $restart_cwd == /* && -d $restart_cwd ]] ||
    die "the Gestalt Mobile restart directory is invalid: $restart_cwd"
  [[ $worker_extra_skills == false || $worker_extra_skills == true ]] ||
    die 'the update-restart worker received an invalid setup mode'
  if [[ $worker_extra_skills == true ]]; then
    update_args+=(--extra-skills)
  fi

  command_update "${update_args[@]}"
  validate_mobile_restart_context "$relay_pid" "$restart_state"
  log "update succeeded; gracefully stopping Gestalt Mobile process $relay_pid"
  kill -TERM "$relay_pid"
  for ((attempt = 0; attempt < 300; attempt += 1)); do
    if ! process_is_live "$relay_pid"; then
      break
    fi
    sleep 0.1
  done
  process_is_live "$relay_pid" &&
    die 'Gestalt Mobile did not stop within 30 seconds; it was not force-killed'

  rm -f -- "$restart_state"
  rmdir -- "$update_restart_lock"
  update_restart_lock=''
  resolve_manager_target
  cd -- "$restart_cwd"
  log 'restarting Gestalt Mobile with its previous options'
  exec "$manager_target" mobile -- "${restart_args[@]}"
}

strip_separator() {
  if (($# > 0)) && [[ $1 == -- ]]; then
    shift
  fi
  forwarded_args=("$@")
}

