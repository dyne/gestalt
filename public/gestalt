#!/usr/bin/env bash
# Manage the isolated Gestalt Codex profile and Gestalt Mobile installation.
set -Eeuo pipefail
IFS=$'\n\t'

readonly GESTALT_CLI_VERSION='0.1.0'
readonly DEFAULT_INSTALL_BASE_URL='https://dyne.github.io/gestalt'
readonly DEFAULT_MARKETPLACE='dyne/gestalt-agents'
readonly DEFAULT_MARKETPLACE_NAME='dyne-gestalt-agents'
manager_update_temp_root=''
manager_update_staged_target=''

log() {
  printf 'gestalt: %s\n' "$*" >&2
}

die() {
  log "error: $*"
  exit 1
}

on_error() {
  local -r exit_code=$?
  local -r line_number=${1:-unknown}
  log "command failed near line ${line_number} (exit ${exit_code})"
  exit "$exit_code"
}
trap 'on_error "$LINENO"' ERR

cleanup() {
  if [[ -n $manager_update_temp_root && -d $manager_update_temp_root ]]; then
    rm -rf -- "$manager_update_temp_root"
  fi
  if [[ -n $manager_update_staged_target && -f $manager_update_staged_target ]]; then
    rm -f -- "$manager_update_staged_target"
  fi
}
trap cleanup EXIT

usage() {
  cat <<'EOF'
Usage: gestalt <command> [options]

Manage Gestalt Agents and Gestalt Mobile in isolated, user-owned directories.

Commands:
  install [--extra-skills]  Install or reconcile Agents and Mobile.
  update [--extra-skills]   Upgrade the manager, Agents, and Mobile.
  cli [--] [args...]        Start Codex with ~/.codex-gestalt as CODEX_HOME.
  mobile [--] [args...]     Start the managed Gestalt Mobile executable.
  doctor                    Check prerequisites and installation state.
  version                   Print this manager's version.
  help                      Show this help.

Environment:
  CODEX_HOME                 Isolated Codex home (default: ~/.codex-gestalt).
  GESTALT_HOME               Runtime and Mobile root (default: ~/.gestalt).
  GESTALT_INSTALL_BASE_URL   Manager update source (default: https://dyne.github.io/gestalt).
  GESTALT_MARKETPLACE        Marketplace source (default: dyne/gestalt-agents).
  GESTALT_MARKETPLACE_NAME   Codex checkout name (default: dyne-gestalt-agents).
  GESTALT_MOBILE_VERSION     npm version or tag (default: latest).
EOF
}

require_command() {
  local -r command_name=$1
  command -v "$command_name" >/dev/null 2>&1 ||
    die "$command_name is required and was not found on PATH"
}

validate_managed_path() {
  local -r label=$1
  local -r candidate=$2
  local home_path

  [[ $candidate == /* ]] || die "$label must be an absolute path: $candidate"
  [[ $candidate != / ]] || die "refusing unsafe $label: /"
  home_path=$(CDPATH='' cd -- "${HOME:?HOME is required}" && pwd -P)
  [[ $candidate != "$home_path" ]] || die "refusing to use HOME itself as $label"
}

load_paths() {
  : "${HOME:?HOME is required}"
  codex_home=${CODEX_HOME:-$HOME/.codex-gestalt}
  gestalt_home=${GESTALT_HOME:-$HOME/.gestalt}
  install_base_url=${GESTALT_INSTALL_BASE_URL:-$DEFAULT_INSTALL_BASE_URL}
  marketplace=${GESTALT_MARKETPLACE:-$DEFAULT_MARKETPLACE}
  marketplace_name=${GESTALT_MARKETPLACE_NAME:-$DEFAULT_MARKETPLACE_NAME}
  mobile_version=${GESTALT_MOBILE_VERSION:-latest}
  mobile_root=$gestalt_home/mobile
  mobile_bin=$mobile_root/node_modules/.bin/gestalt-mobile
  marketplace_setup=$codex_home/.tmp/marketplaces/$marketplace_name/gestalt-setup.sh

  validate_managed_path CODEX_HOME "$codex_home"
  validate_managed_path GESTALT_HOME "$gestalt_home"
}

calculate_sha256() {
  local -r file=$1

  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file"
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file"
  else
    die 'sha256sum or shasum is required to verify the manager'
  fi
}

update_manager() {
  local manager_source manager_dir manager_name manager_target
  local manager_download checksum_download expected_checksum actual_checksum current_checksum

  require_command curl
  require_command install
  require_command mktemp

  manager_source=${BASH_SOURCE[0]}
  manager_dir=$(CDPATH='' cd -- "$(dirname -- "$manager_source")" && pwd -P) ||
    die "could not resolve manager directory: $manager_source"
  manager_name=$(basename -- "$manager_source")
  manager_target=$manager_dir/$manager_name
  [[ -f $manager_target ]] || die "could not resolve manager executable: $manager_target"

  manager_update_temp_root=$(mktemp -d "${TMPDIR:-/tmp}/gestalt-update.XXXXXXXX") ||
    die 'could not create a temporary directory for the manager update'
  manager_download=$manager_update_temp_root/gestalt
  checksum_download=$manager_update_temp_root/gestalt.sha256

  log "checking for a manager update at ${install_base_url%/}/gestalt"
  curl --fail --silent --show-error --location \
    "${install_base_url%/}/gestalt" --output "$manager_download"
  curl --fail --silent --show-error --location \
    "${install_base_url%/}/gestalt.sha256" --output "$checksum_download"

  IFS=' ' read -r expected_checksum _ < "$checksum_download" ||
    die 'could not read the published manager checksum'
  [[ $expected_checksum =~ ^[[:xdigit:]]{64}$ ]] ||
    die 'published manager checksum has an invalid format'

  actual_checksum=$(calculate_sha256 "$manager_download")
  actual_checksum=${actual_checksum%% *}
  [[ $actual_checksum == "$expected_checksum" ]] ||
    die 'manager update checksum verification failed'

  current_checksum=$(calculate_sha256 "$manager_target")
  current_checksum=${current_checksum%% *}
  if [[ $current_checksum == "$actual_checksum" ]]; then
    log "manager is already current at $manager_target"
  else
    manager_update_staged_target=$(mktemp "$manager_dir/.gestalt.XXXXXXXX") ||
      die 'could not stage the manager update'
    install -m 0755 "$manager_download" "$manager_update_staged_target"
    mv -f -- "$manager_update_staged_target" "$manager_target"
    manager_update_staged_target=''
    log "updated manager at $manager_target"
  fi

  rm -rf -- "$manager_update_temp_root"
  manager_update_temp_root=''
}

check_node_version() {
  local version major
  require_command node
  version=$(node -p 'process.versions.node') || die 'could not determine Node.js version'
  major=${version%%.*}
  [[ $major =~ ^[0-9]+$ ]] || die "unexpected Node.js version: $version"
  ((major >= 24)) || die "Node.js 24 or newer is required; found $version"
}

install_mobile() {
  check_node_version
  require_command npm
  mkdir -p -- "$mobile_root"
  log "installing gestalt-mobile@${mobile_version} under $mobile_root"
  npm install \
    --prefix "$mobile_root" \
    --no-audit \
    --no-fund \
    --save-exact \
    "gestalt-mobile@${mobile_version}"
  [[ -x $mobile_bin ]] || die "npm completed but the Mobile executable is missing: $mobile_bin"
}

run_marketplace_setup() {
  local -r mode=$1
  local -r include_extra_skills=$2
  local marketplace_action
  local -a setup_args=()

  check_node_version
  require_command npm
  require_command codex
  mkdir -p -- "$codex_home" "$gestalt_home"

  marketplace_action=upgrade
  if [[ $mode == install && ! -f $marketplace_setup ]]; then
    marketplace_action=add
  fi

  log "${marketplace_action} marketplace $marketplace in $codex_home"
  if [[ $marketplace_action == add ]]; then
    if ! CODEX_HOME=$codex_home codex plugin marketplace add "$marketplace"; then
      log 'marketplace is already registered; attempting an upgrade'
      CODEX_HOME=$codex_home codex plugin marketplace upgrade "$marketplace_name"
    fi
  else
    if ! CODEX_HOME=$codex_home codex plugin marketplace upgrade "$marketplace_name"; then
      log 'marketplace upgrade was unavailable; attempting a fresh registration'
      CODEX_HOME=$codex_home codex plugin marketplace add "$marketplace"
    fi
  fi

  [[ -f $marketplace_setup ]] ||
    die "marketplace setup script is missing after ${marketplace_action}: $marketplace_setup"

  if [[ $include_extra_skills == true ]]; then
    setup_args+=(--extra-skills)
  fi

  log 'preparing context mode, plugins, and agent profiles'
  CODEX_HOME=$codex_home GESTALT_HOME=$gestalt_home \
    bash "$marketplace_setup" "${setup_args[@]}"
}

parse_setup_options() {
  include_extra_skills=false
  while (($# > 0)); do
    case $1 in
      --extra-skills)
        include_extra_skills=true
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        die "unknown setup option: $1"
        ;;
    esac
    shift
  done
}

command_install() {
  parse_setup_options "$@"
  run_marketplace_setup install "$include_extra_skills"
  install_mobile
  log "installation complete; run 'gestalt doctor', then 'gestalt cli' or 'gestalt mobile'"
}

command_update() {
  parse_setup_options "$@"
  update_manager
  run_marketplace_setup upgrade "$include_extra_skills"
  install_mobile
  log 'manager, Agents, and Mobile are up to date'
}

strip_separator() {
  if (($# > 0)) && [[ $1 == -- ]]; then
    shift
  fi
  forwarded_args=("$@")
}

command_cli() {
  require_command codex
  strip_separator "$@"
  log "starting Codex with CODEX_HOME=$codex_home"
  exec env CODEX_HOME="$codex_home" codex "${forwarded_args[@]}"
}

command_mobile() {
  strip_separator "$@"
  if [[ ! -x $mobile_bin ]]; then
    log 'Gestalt Mobile is not installed; installing it now'
    install_mobile
  fi
  log "starting Gestalt Mobile from $mobile_root"
  exec env CODEX_HOME="$codex_home" GESTALT_HOME="$gestalt_home" \
    "$mobile_bin" "${forwarded_args[@]}"
}

print_check() {
  local -r label=$1
  local -r status=$2
  printf '%-24s %s\n' "$label" "$status"
}

read_gestalt_plugin_version() {
  node -e '
    let input = "";
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", chunk => { input += chunk; });
    process.stdin.on("end", () => {
      const result = JSON.parse(input);
      const installed = Array.isArray(result) ? result : result.installed;
      const plugin = Array.isArray(installed)
        ? installed.find(candidate =>
            candidate && candidate.name === "gestalt" && candidate.installed !== false)
        : undefined;
      if (!plugin || typeof plugin.version !== "string" || plugin.version.length === 0) {
        process.exitCode = 1;
        return;
      }
      process.stdout.write(plugin.version);
    });
  '
}

command_doctor() {
  local failed=false node_version codex_version gestalt_plugin_version mobile_version_output

  printf 'Gestalt manager %s\n\n' "$GESTALT_CLI_VERSION"
  print_check 'Codex home' "$codex_home"
  print_check 'Gestalt home' "$gestalt_home"

  if command -v node >/dev/null 2>&1; then
    node_version=$(node -p 'process.versions.node' 2>/dev/null || printf 'unreadable')
    print_check 'Node.js' "$node_version"
    [[ ${node_version%%.*} =~ ^[0-9]+$ ]] && (( ${node_version%%.*} >= 24 )) || failed=true
  else
    print_check 'Node.js' 'MISSING (24+ required)'
    failed=true
  fi

  if command -v npm >/dev/null 2>&1; then
    print_check 'npm' "$(npm --version 2>/dev/null || printf 'unreadable')"
  else
    print_check 'npm' 'MISSING'
    failed=true
  fi

  if command -v codex >/dev/null 2>&1; then
    codex_version=$(codex --version 2>/dev/null || printf 'unreadable')
    print_check 'Codex CLI' "$codex_version"
  else
    print_check 'Codex CLI' 'MISSING'
    failed=true
  fi

  if [[ -f $marketplace_setup ]]; then
    print_check 'Agents marketplace' 'present'
  else
    print_check 'Agents marketplace' 'MISSING'
    failed=true
  fi

  if command -v codex >/dev/null 2>&1 && [[ -d $codex_home ]]; then
    if gestalt_plugin_version=$(
      CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
        read_gestalt_plugin_version 2>/dev/null
    ); then
      print_check 'Gestalt plugins' "$gestalt_plugin_version"
    else
      print_check 'Gestalt plugins' 'NOT VERIFIED'
      failed=true
    fi
  fi

  if [[ -x $mobile_bin ]]; then
    mobile_version_output=$(CODEX_HOME=$codex_home "$mobile_bin" --version 2>/dev/null || printf 'unreadable')
    print_check 'Gestalt Mobile' "$mobile_version_output"
  else
    print_check 'Gestalt Mobile' 'MISSING'
    failed=true
  fi

  if "$failed"; then
    printf "\nRun 'gestalt install' or 'gestalt update' to repair missing components.\n" >&2
    return 1
  fi
  printf "\nAll manager checks passed. Run ctx-doctor inside a fresh 'gestalt cli' session.\n"
}

main() {
  local command_name=${1:-help}
  if (($# > 0)); then shift; fi

  load_paths
  case $command_name in
    install) command_install "$@" ;;
    update) command_update "$@" ;;
    cli) command_cli "$@" ;;
    mobile) command_mobile "$@" ;;
    doctor) command_doctor "$@" ;;
    version | --version | -V) printf 'gestalt %s\n' "$GESTALT_CLI_VERSION" ;;
    help | --help | -h) usage ;;
    *) die "unknown command: $command_name (run 'gestalt help')" ;;
  esac
}

main "$@"
