    GESTALT_STARTUP_DIAGNOSTICS_DONE=1 \
    PATH="$gestalt_home/bin:$codex_home/bin:$PATH" \
    "$mobile_bin" "${forwarded_args[@]}"
}

print_check() {
  local -r label=$1
  local -r status=$2
  printf '%-24s %s\n' "$label" "$status"
}

installed_xerj_version() {
  local output
  output=$(bash "${BASH_SOURCE[0]}" xerj -V 2>/dev/null) || return 0
  if [[ $output =~ ^xerj[[:space:]]+([A-Za-z0-9][A-Za-z0-9.+_-]{0,99})$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  fi
}

command_version() {
  local value plugin
  printf 'gestalt %s\n' "$GESTALT_CLI_VERSION"
  if [[ -x $mobile_bin ]]; then
    value=$("$mobile_bin" --version 2>/dev/null) && print_check 'Gestalt Mobile' "$value"
  fi
  for plugin in gestalt context-mode; do
    value=$(CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
      read_plugin_version "$plugin" 2>/dev/null) || continue
    print_check "$plugin" "$value"
  done
  if command -v codex >/dev/null 2>&1; then
    value=$(codex --version 2>/dev/null) && print_check 'Codex CLI' "$value"
  fi
  if command -v kimi >/dev/null 2>&1; then
    value=$(kimi --version 2>/dev/null) && print_check 'Kimi CLI' "$value"
  fi
  value=$(installed_xerj_version)
  if [[ -n $value ]]; then print_check 'xerj' "$value"; fi
  value=$(serena_versions serena 2>/dev/null || true)
  print_check 'Serena' "${value:-NOT INSTALLED (optional)}"
  value=$(serena_versions uv 2>/dev/null || true)
  print_check 'uv (Serena)' "${value:-NOT INSTALLED (optional)}"
  value=$(serena_versions python 2>/dev/null || true)
  print_check 'Python (Serena)' "${value:-NOT INSTALLED (optional)}"
  return 0
}

check_xerj() {
  local version report
  version=$(installed_xerj_version)
  print_check 'xerj' "${version:-NOT AVAILABLE (optional retrieval)}"
  if [[ -n $version ]]; then
    if command -v flock >/dev/null 2>&1 && command -v setpriv >/dev/null 2>&1; then
      print_check 'xerj auto-index' 'available (flock and setpriv)'
    else
      print_check 'xerj auto-index' 'unavailable: install util-linux flock/setpriv, or use --xerj manual'
    fi
  fi
  if command -v node >/dev/null 2>&1; then
    report=$(bash "${BASH_SOURCE[0]}" xerj probe 2>/dev/null) || report='{}'
    # shellcheck disable=SC2016 # JavaScript owns this interpolation.
    printf '%s' "$report" | node -e '
      let input = "";
      process.stdin.on("data", chunk => { input += chunk; });
      process.stdin.on("end", () => {
        let result;
        try { result = JSON.parse(input); } catch { result = {}; }
        const reason = /^[a-z-]{1,80}$/.test(result.reason ?? "") ? result.reason : "probe-failed";
        console.log("xerj readiness".padEnd(24) + " " +
          (result.status === "ready" ? "ready" : `unavailable (${reason}; direct source search remains available)`));
      });
    '
  fi
}

read_plugin_version() {
  local -r plugin_name=$1
  # shellcheck disable=SC2016 # The Node program intentionally owns its JavaScript interpolation.
  node -e '
    let input = "";
    const pluginName = process.argv[1];
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", chunk => { input += chunk; });
    process.stdin.on("end", () => {
      const result = JSON.parse(input);
      const installed = Array.isArray(result) ? result : result.installed;
      const plugin = Array.isArray(installed)
        ? installed.find(candidate =>
            candidate && candidate.name === pluginName && candidate.installed !== false)
        : undefined;
      if (!plugin || typeof plugin.version !== "string" || plugin.version.length === 0) {
        process.exitCode = 1;
        return;
      }
      process.stdout.write(plugin.version);
    });
  ' "$plugin_name"
}

context_mode_plugin_source_is_disabled() {
  CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
    node -e '
      let input = "";
      process.stdin.setEncoding("utf8");
      process.stdin.on("data", chunk => { input += chunk; });
      process.stdin.on("end", () => {
        const result = JSON.parse(input);
        const installed = Array.isArray(result) ? result : result.installed;
        const plugin = Array.isArray(installed)
          ? installed.find(candidate => candidate && candidate.name === "context-mode")
          : undefined;
        if (!plugin || plugin.installed === false || plugin.enabled !== false) process.exitCode = 1;
      });
    '
}

context_mode_native_mcp_is_enabled() {
  local -r expected_launcher=$codex_home/bin/context-mode-mcp.mjs

  CODEX_HOME=$codex_home codex mcp get context-mode --json 2>/dev/null |
    node -e '
      let input = "";
      const expectedLauncher = process.argv[1];
      process.stdin.setEncoding("utf8");
      process.stdin.on("data", chunk => { input += chunk; });
      process.stdin.on("end", () => {
        const server = JSON.parse(input);
        const command = server.transport?.command ?? server.command;
        const args = server.transport?.args ?? server.args;
        if (server.enabled !== true || command !== "node" ||
            !Array.isArray(args) || args.length !== 1 || args[0] !== expectedLauncher) {
          process.exitCode = 1;
        }
      });
    ' "$expected_launcher"
}

context_mode_runtime_root() {
  # Older marketplace releases still prepare a versioned tree. Keep discovery
  # compatible until their next setup migrates it to the single runtime.
  if [[ ! -f $gestalt_home/runtime/context-mode/.context-mode-prepared.json ]]; then
    local runtime_identity legacy
    runtime_identity=$(node -p '[process.platform, process.arch, "node-" + process.versions.modules].join("-")') || return 1
    legacy=$gestalt_home/runtime/context-mode/$1/$runtime_identity
    if [[ -f $legacy/.context-mode-prepared.json ]]; then
      printf '%s\n' "$legacy"
      return
    fi
  fi
  printf '%s/runtime/context-mode\n' "$gestalt_home"
}

installed_plugin_version() {
  local -r plugin_name=$1
  local inherited_version=''

  case $plugin_name in
    gestalt) inherited_version=${GESTALT_AGENTS_VERSION:-} ;;
    context-mode) inherited_version=${GESTALT_CONTEXT_MODE_VERSION:-} ;;
    *) die "unsupported plugin path: $plugin_name" ;;
  esac
  if [[ -n $inherited_version ]]; then
    printf '%s\n' "$inherited_version"
    return 0
  fi
  command -v codex >/dev/null 2>&1 ||
    die "cannot resolve $plugin_name: codex is not available and no session version was exported"
  CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
    read_plugin_version "$plugin_name" ||
    die "cannot resolve the installed $plugin_name plugin version"
}

managed_path() {
  local -r name=$1
  local version

  case $name in
    bin) printf '%s/bin\n' "$gestalt_home" ;;
    org-plan | context-mode-cli) printf '%s/bin/%s\n' "$gestalt_home" "${name%-cli}" ;;
    mobile) printf '%s\n' "${GESTALT_MOBILE_BIN:-$mobile_bin}" ;;
    context-mode | context-mode-runtime)
      if [[ -n ${GESTALT_CONTEXT_MODE_RUNTIME:-} ]]; then
        printf '%s\n' "$GESTALT_CONTEXT_MODE_RUNTIME"
      else
        version=$(installed_plugin_version context-mode)
        context_mode_runtime_root "$version"
      fi
      ;;
    context-mode-plugin)
      if [[ -n ${GESTALT_CONTEXT_MODE_PLUGIN_ROOT:-} ]]; then
        printf '%s\n' "$GESTALT_CONTEXT_MODE_PLUGIN_ROOT"
      else
        version=$(installed_plugin_version context-mode)
        printf '%s/plugins/cache/%s/context-mode/%s\n' "$codex_home" "$marketplace_name" "$version"
      fi
      ;;
    gestalt-plugin)
      if [[ -n ${GESTALT_AGENTS_PLUGIN_ROOT:-} ]]; then
        printf '%s\n' "$GESTALT_AGENTS_PLUGIN_ROOT"
      else
        version=$(installed_plugin_version gestalt)
        printf '%s/plugins/cache/%s/gestalt/%s\n' "$codex_home" "$marketplace_name" "$version"
      fi
      ;;
    codex-home) printf '%s\n' "$codex_home" ;;
    gestalt-home) printf '%s\n' "$gestalt_home" ;;
    *)
      die "unknown managed path: $name (expected bin, org-plan, context-mode-cli, mobile, context-mode, context-mode-plugin, gestalt-plugin, codex-home, or gestalt-home)"
      ;;
  esac
}

command_path() {
  local name mobile_path context_runtime context_plugin gestalt_plugin

  if (($# == 1)) && [[ $1 != --json ]]; then
    managed_path "$1"
    return
  fi
  (($# == 0)) || { (($# == 1)) && [[ $1 == --json ]]; } ||
    die 'usage: gestalt path [NAME|--json]'

  mobile_path=$(managed_path mobile)
  context_runtime=$(managed_path context-mode)
  context_plugin=$(managed_path context-mode-plugin)
  gestalt_plugin=$(managed_path gestalt-plugin)
  if (($# == 1)); then
    # shellcheck disable=SC2016 # The Node program intentionally owns its JavaScript interpolation.
    node -e '
      const [mobile, contextModeRuntime, contextModePlugin, gestaltPlugin, codexHome, gestaltHome] =
        process.argv.slice(1);
      process.stdout.write(`${JSON.stringify({
        mobile,
        contextModeRuntime,
        contextModePlugin,
        gestaltPlugin,
        codexHome,
        gestaltHome,
        bin: `${gestaltHome}/bin`,
        contextModeCli: `${gestaltHome}/bin/context-mode`,
        orgPlan: `${gestaltHome}/bin/org-plan`,
      })}\n`);
    ' "$mobile_path" "$context_runtime" "$context_plugin" "$gestalt_plugin" "$codex_home" "$gestalt_home"
    return
  fi
  print_check 'Gestalt Mobile' "$mobile_path"
  print_check 'Gestalt commands' "$gestalt_home/bin"
  print_check 'Context-mode runtime' "$context_runtime"
  print_check 'Context-mode plugin' "$context_plugin"
  print_check 'Gestalt plugin' "$gestalt_plugin"
  print_check 'Codex home' "$codex_home"
  print_check 'Gestalt home' "$gestalt_home"
}

context_mode_runtime_is_prepared() {
  local -r version=$1
  local runtime_root marker
  runtime_root=$(context_mode_runtime_root "$version") || return 1
  marker=$runtime_root/.context-mode-prepared.json
  [[ -f $marker && -f $runtime_root/cli.bundle.mjs && -f $runtime_root/server.bundle.mjs ]] ||
    return 1
  node -e '
    const fs = require("node:fs");
    const marker = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    if (marker.packageVersion !== process.argv[2] ||
        marker.nodeModulesAbi !== process.versions.modules ||
        marker.platform !== process.platform || marker.arch !== process.arch) process.exit(1);
  ' "$marker" "$version"
}

read_supervision_capabilities() {
  local -r component=$1
  local -r manifest=$2

  if [[ ! -f $manifest ]]; then
    printf 'UNAVAILABLE'
    return 0
  fi
  if [[ ! -r $manifest || $(wc -c < "$manifest") -gt 16384 ]]; then
    printf 'MALFORMED'
    return 0
  fi

  # shellcheck disable=SC2016 # The Node program intentionally owns its JavaScript interpolation.
  node -e '
    const fs = require("node:fs");
    const [file, component, schema, contract] = process.argv.slice(1);
    try {
      const value = JSON.parse(fs.readFileSync(file, "utf8"));
      const capabilities = value.capabilities;
      if (!value || typeof value !== "object" || Array.isArray(value) ||
          value.schemaVersion !== Number(schema) || value.component !== component ||
          !Number.isInteger(value.supervisionContract) ||
          !Array.isArray(capabilities) ||
          capabilities.some(capability => typeof capability !== "string" ||
            !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(capability))) {
        process.stdout.write("MALFORMED");
      } else {
        process.stdout.write(`READY|${value.supervisionContract}|${[...new Set(capabilities)].sort().join(",")}`);
      }
    } catch {
      process.stdout.write("MALFORMED");
    }
  ' "$manifest" "$component" "$SUPERVISION_CAPABILITY_SCHEMA" "$SUPERVISION_CONTRACT_VERSION"
}

has_supervision_capability() {
  local -r capabilities=$1
  local -r expected=$2
  [[ ,$capabilities, == *",$expected,"* ]]
}

check_supervision_capability_coherence() {
  local agents mobile agents_contract agents_capabilities mobile_contract mobile_capabilities
  local capability
  local -a agents_required=(supervision-start wait-lease-tool checkpoint-tool agent-capacity-recovery canonical-agent-identity org-plan-contract)
  local -a mobile_required=(supervision-start wait-lease-tool checkpoint-tool agent-capacity-recovery controller-status canonical-agent-identity session-verdict acknowledgement-safe-composer org-plan-contract)

  agents=$(read_supervision_capabilities agents "$agents_capability_manifest")
  mobile=$(read_supervision_capabilities mobile "$mobile_capability_manifest")
  if [[ $agents == UNAVAILABLE ]]; then
    print_check 'Agents supervision' 'UNAVAILABLE (run gestalt update, then restart Mobile)'
    return 1
  fi
  if [[ $mobile == UNAVAILABLE ]]; then
    print_check 'Mobile supervision' 'UNAVAILABLE (run gestalt update, then restart Mobile)'
    return 1
  fi
  if [[ $agents == MALFORMED ]]; then
    print_check 'Agents supervision' 'INCOMPATIBLE (malformed capability manifest; run gestalt update, then restart Mobile)'
    return 1
  fi
  if [[ $mobile == MALFORMED ]]; then
    print_check 'Mobile supervision' 'INCOMPATIBLE (malformed capability manifest; run gestalt update, then restart Mobile)'
    return 1
  fi

  IFS='|' read -r _ agents_contract agents_capabilities <<< "$agents"
  IFS='|' read -r _ mobile_contract mobile_capabilities <<< "$mobile"
  if [[ $agents_contract != "$SUPERVISION_CONTRACT_VERSION" || $mobile_contract != "$SUPERVISION_CONTRACT_VERSION" || $agents_contract != "$mobile_contract" ]]; then
    print_check 'Supervision contract' "INCOMPATIBLE (Agents=$agents_contract Mobile=$mobile_contract; run gestalt update, then restart Mobile)"
    return 1
  fi
  for capability in "${agents_required[@]}"; do
    if ! has_supervision_capability "$agents_capabilities" "$capability"; then
      print_check 'Agents supervision' "INCOMPATIBLE (missing $capability; run gestalt update, then restart Mobile)"
      return 1
    fi
  done
  for capability in "${mobile_required[@]}"; do
    if ! has_supervision_capability "$mobile_capabilities" "$capability"; then
      print_check 'Mobile supervision' "INCOMPATIBLE (missing $capability; run gestalt update, then restart Mobile)"
      return 1
    fi
  done
  print_check 'Supervision contract' "ready (v$agents_contract; offline manifests)"
}

verify_context_mode_installation() {
  local gestalt_version context_version runtime_root
  gestalt_version=$(
    CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
      read_plugin_version gestalt
  ) || die 'Gestalt plugin is not installed after marketplace setup'
  context_version=$(
    CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
      read_plugin_version context-mode
  ) || die 'context-mode plugin is not installed after marketplace setup'
  [[ $context_version == "$gestalt_version" ]] ||
    die "plugin version skew after marketplace setup: gestalt=$gestalt_version context-mode=$context_version"
  runtime_root=$(context_mode_runtime_root "$context_version") ||
    die 'could not resolve the context-mode runtime path'
  context_mode_runtime_is_prepared "$context_version" ||
    die "context-mode $context_version runtime is not prepared: $runtime_root"
  context_mode_plugin_source_is_disabled ||
    die 'context-mode plugin source must remain disabled; run gestalt install or gestalt update to restore the native MCP bridge'
  context_mode_native_mcp_is_enabled ||
    die 'context-mode native MCP bridge is missing or disabled; run gestalt install or gestalt update'
  log "verified context-mode $context_version plugin and external runtime"
}

run_doctor_command() {
  local -r label=$1
  shift
  printf '\n%s\n' "$label"
  if "$@"; then
    return 0
  fi
  log "$label reported a problem"
  return 1
}

run_startup_diagnostics() {
  log 'running startup diagnostics'
  if ! command_doctor; then
    log 'startup diagnostics reported a problem; launch will continue after required runtime checks'
  fi
}

command_doctor() {
  local failed=false node_version codex_version gestalt_plugin_version
  local context_mode_plugin_version context_mode_runtime mobile_version_output

  printf 'Gestalt manager %s\n\n' "$GESTALT_CLI_VERSION"
  print_check 'Codex home' "$codex_home"
  print_check 'Gestalt home' "$gestalt_home"

  if command -v node >/dev/null 2>&1; then
    node_version=$(node -p 'process.versions.node' 2>/dev/null || printf 'unreadable')
    print_check 'Node.js' "$node_version"
    [[ ${node_version%%.*} =~ ^[0-9]+$ ]] && (( ${node_version%%.*} >= 24 )) || failed=true
  else
    print_check 'Node.js' 'MISSING (24+ required)'
    failed=true
  fi

  if command -v npm >/dev/null 2>&1; then
    print_check 'npm' "$(npm --version 2>/dev/null || printf 'unreadable')"
  else
    print_check 'npm' 'MISSING'
    failed=true
  fi

  if command -v codex >/dev/null 2>&1; then
    codex_version=$(codex --version 2>/dev/null || printf 'unreadable')
    print_check 'Codex CLI' "$codex_version"
  else
    print_check 'Codex CLI' 'MISSING'
    failed=true
  fi

  if [[ -f $marketplace_setup ]]; then
    print_check 'Agents marketplace' 'present'
  else
    print_check 'Agents marketplace' 'MISSING'
    failed=true
  fi

  if command -v codex >/dev/null 2>&1 && [[ -d $codex_home ]]; then
    if gestalt_plugin_version=$(
      CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
        read_plugin_version gestalt 2>/dev/null
    ); then
      print_check 'Gestalt plugins' "$gestalt_plugin_version"
    else
      print_check 'Gestalt plugins' 'NOT VERIFIED'
      failed=true
    fi
    if context_mode_plugin_version=$(
      CODEX_HOME=$codex_home codex plugin list --marketplace "$marketplace_name" --json 2>/dev/null |
        read_plugin_version context-mode 2>/dev/null
    ); then
      print_check 'Context-mode plugin' "$context_mode_plugin_version"
      if [[ -n ${gestalt_plugin_version:-} &&
            $context_mode_plugin_version != "$gestalt_plugin_version" ]]; then
        print_check 'Plugin version match' \
          "MISMATCH (gestalt=$gestalt_plugin_version context-mode=$context_mode_plugin_version)"
        failed=true
      elif context_mode_runtime_is_prepared "$context_mode_plugin_version"; then
        context_mode_runtime=$(context_mode_runtime_root "$context_mode_plugin_version")
        print_check 'Context-mode runtime' "$context_mode_runtime"
      else
        context_mode_runtime=$(context_mode_runtime_root "$context_mode_plugin_version" || printf 'unresolved')
        print_check 'Context-mode runtime' "NOT PREPARED ($context_mode_runtime)"
        failed=true
      fi
      if context_mode_plugin_source_is_disabled; then
        print_check 'Plugin MCP source' 'disabled (expected)'
      else
        print_check 'Plugin MCP source' 'ENABLED (disable it; native bridge owns startup)'
        failed=true
      fi
      if context_mode_native_mcp_is_enabled; then
        print_check 'Native context MCP' 'enabled'
      else
        print_check 'Native context MCP' 'MISSING OR DISABLED'
        failed=true
      fi
    else
      print_check 'Context-mode plugin' 'NOT VERIFIED'
      failed=true
    fi
  fi

  if [[ -x $mobile_bin ]]; then
    mobile_version_output=$(CODEX_HOME=$codex_home "$mobile_bin" --version 2>/dev/null || printf 'unreadable')
    print_check 'Gestalt Mobile' "$mobile_version_output"
  else
    print_check 'Gestalt Mobile' 'MISSING'
    failed=true
  fi

  check_supervision_capability_coherence || failed=true
  check_xerj

  if command -v codex >/dev/null 2>&1; then
    run_doctor_command 'Codex doctor' \
      env CODEX_HOME="$codex_home" codex doctor --summary --ascii --no-color || failed=true
  fi

  if [[ -n ${context_mode_runtime:-} && -f $context_mode_runtime/cli.bundle.mjs ]]; then
    run_doctor_command 'Context-mode doctor' \
      env CODEX_HOME="$codex_home" GESTALT_HOME="$gestalt_home" \
      CONTEXT_MODE_PLATFORM=codex CONTEXT_MODE_WORKSPACE="$PWD" \
      node "$context_mode_runtime/cli.bundle.mjs" doctor || failed=true
  fi

  run_doctor_command 'Bubblewrap and Codex sandbox' command_sandbox_doctor || failed=true

  if [[ -f $gestalt_home/serena/active.json ]]; then
    run_doctor_command 'Serena doctor' command_serena doctor || failed=true
  else
    print_check 'Serena' 'NOT INSTALLED (optional; gestalt serena install)'
  fi

  if "$failed"; then
    printf "\nRun 'gestalt install' or 'gestalt update' to repair missing components.\n" >&2
    return 1
  fi
  printf "\nAll startup diagnostics passed.\n"
}

main() {
  local command_name=${1:-help}
  if (($# > 0)); then shift; fi

  load_paths
  case $command_name in
    install) command_install "$@" ;;
    update) command_update "$@" ;;
    update-restart) command_update_restart "$@" ;;
    __update-restart-worker) command_update_restart_worker "$@" ;;
    cli) command_cli "$@" ;;
    mobile) command_mobile "$@" ;;
    xerj) command_xerj "$@" ;;
    serena) command_serena "$@" ;;
    path) command_path "$@" ;;
    skills-export) command_skills_export "$@" ;;
    skills-import) command_skills_import "$@" ;;
    doctor) command_doctor "$@" ;;
    version | --version | -V) command_version ;;
    help | --help | -h) usage ;;
    *) die "unknown command: $command_name (run 'gestalt help')" ;;
  esac
}

main "$@"
