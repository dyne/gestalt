{
  "name": "gestalt-mobile",
  "version": "0.1.0",
  "description": "Mobile-first web relay for durable Codex development sessions",
  "keywords": [
    "codex",
    "gestalt",
    "mobile",
    "development"
  ],
  "homepage": "https://github.com/dyne/gestalt-mobile#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyne/gestalt-mobile.git"
  },
  "bugs": {
    "url": "https://github.com/dyne/gestalt-mobile/issues"
  },
  "author": "Dyne.org foundation",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "gestalt-mobile": "dist/server/server/main.js"
  },
  "files": [
    "dist/server",
    "dist/client",
    "README.md",
    "LICENSE",
    "gestalt-supervision-capabilities.json"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/gestalt-environment.mjs tsx watch src/server/main.ts --cwd .. --port 3001 --public-origin http://localhost:5173 --data-dir .gestalt/dev-state --disable-passkey-auth",
    "prestart": "npm run build",
    "start": "node scripts/start.mjs",
    "dev:client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "node scripts/build-server.mjs",
    "build:client": "vite build",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.server.json --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json-summary",
    "test:vitest": "vitest run --config vitest.unit.config.ts",
    "test:auth:stress": "AUTH_CONTENTION_STRESS=1 vitest run --config vitest.auth-stress.config.ts --reporter=default --reporter=json --outputFile=test-results/auth-stress.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:open-profile-smoke": "tsx scripts/open-profile-smoke.ts",
    "test:watch": "vitest",
    "test:package": "node scripts/smoke-packed-cli.mjs",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test --config playwright.functional.config.ts",
    "test:e2e:shards": "node scripts/verify-browser-shards.mjs",
    "test:e2e:evidence": "PLAYWRIGHT_EVIDENCE=1 playwright test --config playwright.evidence.config.ts",
    "test:e2e:real-auth": "playwright test --config playwright.auth.config.ts",
    "test:lanes": "node scripts/verify-test-lanes.mjs",
    "test:e2e:plan-lifecycle": "npm run build:client && playwright test test/e2e/plan-lifecycle.spec.ts",
    "test:e2e:plan-evidence": "playwright test test/e2e/plan-ui-evidence.spec.ts",
    "license:check": "node scripts/check-license-headers.mjs",
    "license:apply": "node scripts/apply-license-headers.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "^10.1.0",
    "@fontsource/jetbrains-mono": "5.2.7",
    "@fontsource/syne": "5.2.7",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "dompurify": "^3.4.16",
    "fastify": "^5.12.3",
    "marked": "^18.0.14",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
