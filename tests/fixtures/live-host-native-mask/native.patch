+    fn assert_unreadable_directory_mask(args: &BwrapArgs, target: &Path) {
+        let target = path_to_string(target);
+        assert!(args.args.windows(4).any(|args| {
+            args == ["--perms", "000", "--tmpfs", target.as_str()]
+        }), "denied metadata must use an unreadable directory mask");
+        assert!(!args.args.windows(3).any(|args| {
+            args[0] == "--ro-bind-data" && args[2] == target
+        }), "a directory target must never receive a file-data mask");
+    }
