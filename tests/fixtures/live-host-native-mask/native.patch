+#[tokio::test]
+async fn sandbox_enforces_denied_metadata_directory_and_file_types() {
+    assert!(!should_skip_bwrap_tests().await, "native metadata regression requires supported bubblewrap");
+    for kind in ["missing", "empty-directory", "directory", "empty-file", "file"] {
+        let workspace = tempfile::tempdir().expect("workspace fixture");
+        let metadata = workspace.path().join(".codex");
+        if kind == "directory" || kind == "empty-directory" {
+            std::fs::create_dir(&metadata).expect("existing directory fixture");
+            if kind == "directory" {
+                std::fs::write(metadata.join("config.toml"), "private fixture").expect("fixture content");
+            }
+        } else if kind == "empty-file" {
+            std::fs::File::create(&metadata).expect("existing empty file fixture");
+        } else if kind == "file" {
+            std::fs::write(&metadata, "private fixture").expect("existing file fixture");
+        }
+        let policy = FileSystemSandboxPolicy::restricted(vec![
+            FileSystemSandboxEntry::new(
+                FileSystemPath::Special { value: FileSystemSpecialPath::Root },
+                FileSystemAccessMode::Read,
+            ),
+            FileSystemSandboxEntry::new(
+                AbsolutePathBuf::try_from(workspace.path()).unwrap().into(),
+                FileSystemAccessMode::Write,
+            ),
+            FileSystemSandboxEntry::new(
+                AbsolutePathBuf::try_from(metadata.as_path()).unwrap().into(),
+                FileSystemAccessMode::Deny,
+            ),
+        ]);
+        let profile = PermissionProfile::from_runtime_permissions(&policy, NetworkSandboxPolicy::Restricted);
+        std::fs::write(workspace.path().join("AGENTS.md"), "instructions").expect("project instructions fixture");
+        let output = run_cmd_result_with_permission_profile_for_cwd(
+            &["bash", "-c", r#"cat "$1/AGENTS.md"
+printf allowed > "$1/public"
+if cat "$1/.codex" 2>/dev/null; then exit 11; fi
+if ls "$1/.codex/" 2>/dev/null; then exit 12; fi
+if (printf injected > "$1/.codex/config.toml") 2>/dev/null; then exit 13; fi
+printf denied"#, "metadata-regression", workspace.path().to_str().unwrap()],
+            AbsolutePathBuf::try_from(workspace.path()).unwrap(),
+            profile,
+            create_env_from_core_vars(),
+            LONG_TIMEOUT_MS,
+            /*use_legacy_landlock*/ false,
+        ).await.expect("native sandbox must launch without directory/file mask collision");
+        let stderr_class = if output.stderr.text.contains("Is a directory") {
+            "EISDIR"
+        } else if output.stderr.text.contains("Not a directory") {
+            "ENOTDIR"
+        } else if output.stderr.text.contains("Permission denied") {
+            "EACCES"
+        } else if output.stderr.text.contains("Read-only file system") {
+            "EROFS"
+        } else if output.stderr.text.contains("No such file or directory") {
+            "ENOENT"
+        } else {
+            "unclassified"
+        };
+        assert_eq!(output.exit_code, 0,
+            "NATIVE_METADATA_EXIT kind={kind} exitCode={} stderrClass={stderr_class} stdoutBytes={} stderrBytes={}",
+            output.exit_code, output.stdout.text.len(), output.stderr.text.len());
+        assert_eq!(output.stdout.text, "instructionsdenied");
+        assert_eq!(std::fs::read_to_string(workspace.path().join("public")).unwrap(), "allowed");
+        if kind == "directory" {
+            assert_eq!(std::fs::read_to_string(metadata.join("config.toml")).unwrap(), "private fixture");
+        } else if kind == "file" {
+            assert_eq!(std::fs::read_to_string(&metadata).unwrap(), "private fixture");
+        } else if kind == "empty-directory" {
+            assert!(metadata.is_dir(), "pre-existing empty directory must be preserved");
+        } else if kind == "empty-file" {
+            assert!(metadata.is_file(), "pre-existing empty file must be preserved");
+        }
+    }
