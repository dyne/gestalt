+    #[test]
+    fn denied_missing_protected_metadata_keeps_directory_mask() {
+        for name in [".codex", ".git", ".agents", ".aws"] {
+            let workspace = TempDir::new().expect("workspace");
+            let metadata = workspace.path().join(name);
+            let policy = denied_metadata_policy(workspace.path(), &metadata);
+            let args = create_filesystem_args(&policy, workspace.path(), BwrapOptions::default())
+                .expect("filesystem args");
+            assert_unreadable_directory_mask(&args, &metadata);
+            let targets = args.synthetic_mount_targets.iter()
+                .filter(|target| target.path() == metadata).collect::<Vec<_>>();
+            assert_eq!(targets.len(), 1);
+            assert_eq!(targets[0].kind(), SyntheticMountTargetKind::EmptyDirectory);
+            assert!(!metadata.exists(), "argument construction must not create host metadata");
+            assert!(!policy.can_read_local_path_with_cwd(&metadata, workspace.path()));
+            assert!(!policy.can_write_local_path_with_cwd(&metadata, workspace.path()));
+        }
