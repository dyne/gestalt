{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Focused Unix setup correction transport evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "state",
    "target",
    "node",
    "uid",
    "startedAt",
    "finishedAt",
    "commands",
    "groups",
    "prerequisites",
    "cleanup",
    "failure",
    "exclusions",
    "lane",
    "runnerImage",
    "kernel"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "state": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "target": {
      "type": "string"
    },
    "node": {
      "type": "string"
    },
    "uid": {
      "type": [
        "integer",
        "null"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "failure": {
      "type": [
        "object",
        "null"
      ]
    },
    "exclusions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "cleanup": {
      "type": "object",
      "required": [
        "path",
        "attempted",
        "removed",
        "retainedForMacManagedAuthority",
        "retentionReasons"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempted": {
          "type": "boolean"
        },
        "removed": {
          "type": "boolean"
        },
        "retainedForMacManagedAuthority": {
          "type": "boolean"
        },
        "retentionReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "failed-or-unexecuted",
              "macos-managed-authority"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "retentionReasons": {
                "minItems": 1
              }
            }
          },
          "then": {
            "properties": {
              "attempted": {
                "const": false
              },
              "removed": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "prerequisites": {
      "type": "object"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "argv",
          "cwd",
          "timeout",
          "startedAt",
          "observedAt",
          "exit",
          "signal",
          "error",
          "stdout",
          "stderr"
        ],
        "properties": {
          "exit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stdout": {
            "$ref": "#/$defs/file"
          },
          "stderr": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "expected"
        ],
        "properties": {
          "id": {
            "enum": [
              "installed-public",
              "linux-managed-retry",
              "linux-package",
              "mac-managed-composition",
              "ordinary-public",
              "shell-contract"
            ]
          },
          "state": {
            "enum": [
              "pass",
              "fail",
              "unexecuted"
            ]
          },
          "blockedBy": {
            "type": "array",
            "items": {
              "enum": [
                "ancestry",
                "managed-host",
                "codex",
                "bash"
              ]
            }
          },
          "tap": {
            "type": "object",
            "required": [
              "cases",
              "counts"
            ],
            "properties": {
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "state",
                    "skipReason"
                  ],
                  "properties": {
                    "state": {
                      "enum": [
                        "pass",
                        "fail",
                        "skip"
                      ]
                    }
                  }
                }
              },
              "counts": {
                "type": "object"
              }
            }
          },
          "phaseReceipt": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "lane": {
      "enum": [
        "mac-bash",
        "linux-managed",
        "linux-delivery",
        null
      ]
    },
    "runnerImage": {
      "type": [
        "string",
        "null"
      ]
    },
    "kernel": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "pass"
          }
        }
      },
      "then": {
        "required": [
          "manager",
          "agents",
          "npm",
          "lockfileModules",
          "host",
          "scheduledRunner"
        ],
        "properties": {
          "target": {
            "enum": [
              "linux-x64",
              "darwin-arm64"
            ]
          },
          "node": {
            "const": "v24.22.3"
          },
          "uid": {
            "type": "integer",
            "minimum": 1
          },
          "failure": {
            "type": "null"
          },
          "groups": {
            "items": {
              "properties": {
                "state": {
                  "const": "pass"
                }
              }
            }
          },
          "runnerImage": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneOf": [
          {
            "properties": {
              "lane": {
                "const": "mac-bash"
              },
              "target": {
                "const": "darwin-arm64"
              },
              "scheduledRunner": {
                "const": "macos-latest"
              },
              "groups": {
                "minItems": 4,
                "maxItems": 4,
                "prefixItems": [
                  {
                    "properties": {
                      "id": {
                        "const": "shell-contract"
                      }
                    }
                  },
                  {
                    "properties": {
                      "id": {
                        "const": "ordinary-public"
                      }
                    }
                  },
                  {
                    "properties": {
                      "id": {
                        "const": "installed-public"
                      }
                    }
                  },
                  {
                    "properties": {
                      "id": {
                        "const": "mac-managed-composition"
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "properties": {
              "lane": {
                "const": "linux-managed"
              },
              "target": {
                "const": "linux-x64"
              },
              "scheduledRunner": {
                "const": "ubuntu-22.04"
              },
              "groups": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [
                  {
                    "properties": {
                      "id": {
                        "const": "linux-managed-retry"
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "properties": {
              "lane": {
                "const": "linux-delivery"
              },
              "target": {
                "const": "linux-x64"
              },
              "scheduledRunner": {
                "const": "ubuntu-latest"
              },
              "groups": {
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "properties": {
                      "id": {
                        "const": "installed-public"
                      }
                    }
                  },
                  {
                    "properties": {
                      "id": {
                        "const": "linux-package"
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "mode",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
