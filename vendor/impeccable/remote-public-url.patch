+            (Some("https://preview.example/live?token=bad"), None),
+            (Some("https://preview.example/live#fragment"), None),
+        ] {
+            std::fs::write(dir.join("index.html"), html).unwrap();
+            let mut env = std::collections::HashMap::new();
+            if let Some(value) = setting {
+                env.insert("IMPECCABLE_LIVE_PUBLIC_BASE_URL".into(), value.into());
+            }
+            let (mut io, _) = Io::captured("", dir.clone(), env);
+            let code = inject_cli(&["--port".into(), "8412".into(), "--token".into(), "test token".into()], &mut io);
+            let after = std::fs::read_to_string(dir.join("index.html")).unwrap();
+            if let Some(base) = expected {
+                assert_eq!(code, 0);
+                assert!(after.contains(&format!("src=\"{}/live.js?token=test%20token\"", base)), "{after}");
+                let origin = if setting.is_some() { "https://preview.example" } else { base };
+                assert!(after.contains(&format!("connect-src 'self' {}", origin)), "{after}");
+                assert_eq!(revert_csp_meta(&remove_tag(&after)), html);
+            } else {
+                assert_eq!(code, 1, "{setting:?}");
+                assert_eq!(after, html);
+            }
+        }
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+}
