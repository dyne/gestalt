+//! The browser-facing helper address; server-side clients still use loopback.
+
+use crate::util::Env;
+
+pub const PUBLIC_BASE_URL_ENV: &str = "IMPECCABLE_LIVE_PUBLIC_BASE_URL";
+
+pub fn public_base_url(env: &Env) -> Result<Option<String>, String> {
+    let Some(raw) = env.get(PUBLIC_BASE_URL_ENV) else {
+        return Ok(None);
+    };
+    let invalid = || format!("{} must be an absolute HTTP(S) URL without userinfo, query or fragment", PUBLIC_BASE_URL_ENV);
+    if raw.is_empty() || raw.chars().any(|c| c.is_control() || c.is_whitespace() || c == '\\') {
+        return Err(invalid());
+    }
+    let url = url::Url::parse(raw).map_err(|_| invalid())?;
+    let authority = raw.split_once("://").map(|(_, rest)| rest.split('/').next().unwrap_or("")).unwrap_or("");
+    if !matches!(url.scheme(), "http" | "https") || url.host_str().is_none()
+        || authority.is_empty() || authority.contains('@') || !url.username().is_empty() || url.password().is_some()
+        || url.query().is_some() || url.fragment().is_some()
+    {
+        return Err(invalid());
+    }
+    // Adapter source uses quoted JavaScript strings as well as HTML attributes.
+    Ok(Some(url.as_str().trim_end_matches('/').replace('\'', "%27").replace('&', "%26")))
+}
+
+pub fn helper_base_url(port: i64, public: Option<&str>) -> String {
+    public.map(str::to_string).unwrap_or_else(|| format!("http://localhost:{}", port))
+}
+
+pub fn helper_origin(base: &str) -> String {
+    url::Url::parse(base).map(|url| url.origin().ascii_serialization()).unwrap_or_else(|_| base.to_string())
+}
